.my-toolbar {
    margin-top: 12px;
    padding: 0px 24px;
    border-radius: 8px;
    background: white;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.1);
}

.toolbar-label {
    font-size: 22px;
}


.my-toolbar .dx-button .dx-icon,
.my-toolbar .dx-button .dx-button-icon,
.my-toolbar .dx-toolbar .dx-button .dx-icon {
    width: 12px !important;
    height: 12px !important;
    line-height: 12px !important;
    font-size: 12px !important;
    transform: scale(2) !important;
    transform-origin: center center;
}


