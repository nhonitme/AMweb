import * as React from "react"
import TextBox, { ITextBoxOptions } from "devextreme-react/text-box"

import { cn } from "@/lib/utils"

export interface InputProps extends ITextBoxOptions {}

const Input = React.forwardRef<any, InputProps>(({ className, ...props }, ref) => {
  return <TextBox ref={ref} className={cn(className)} {...props} />
})

Input.displayName = "Input"

export { Input }
