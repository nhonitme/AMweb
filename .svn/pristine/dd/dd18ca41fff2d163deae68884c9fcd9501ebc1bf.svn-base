.data-tree-list-container {
  width: 100%;
  height: 100%;
  min-height: 0;
  min-width: 0;

  box-shadow: 0 4px 4px rgba(0, 0, 0, 0.1);
  border-radius: 8px;

  .dx-treelist {

    .dx-treelist-headers .dx-row > td,
    .dx-treelist-rowsview .dx-row > td {
      border-right: 1px dashed rgba(0, 0, 0, 0.12);
    }

    .dx-treelist-rowsview .dx-row:not(:hover) .dx-command-edit,
    .dx-treelist-rowsview .dx-row:not(:hover) .dx-command-delete,
    .dx-treelist-rowsview .dx-row:not(:hover) .dx-command-more {
      visibility: hidden;
    }

  }
}
