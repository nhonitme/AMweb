import React, { useContext } from "react";
import { Column } from "devextreme-react/tree-list";
import { LanguageContext } from '@/lib/i18nLoader';

export const AcclistColumns: React.FC = () => {
  const { translate } = useContext(LanguageContext) as { translate: (k: string, f?: string) => string };
  return (
    <>
      <Column 
        type="buttons"
        width={100}
        showInColumnChooser={false}
        //caption={translate('btnSelect4', 'Choose')}
      />
      {<Column dataField="ACC_CD" caption={translate('ACC_CD', 'Account Code')} />}
      {<Column dataField="ACC_ID" caption={translate('ACC_ID', 'Account ID')} visible={false}  showInColumnChooser={false} />}
      {<Column dataField="ACCTITLE_NM_VIET" caption={translate('ACCTITLE_NM_VIET', 'Acc name viet')} />}
      {<Column dataField="ACCTITLE_NM_ENG" caption={translate('ACCTITLE_NM_ENG', 'Acc name eng')} />}
      {<Column dataField="ACCTITLE_NM_KOR" caption={translate('ACCTITLE_NM_KOR', 'Acc name kor')} />}
      {<Column dataField="ACCTITLE_NM_CHINA" caption={translate('ACCTITLE_NM_CHINA', 'Acc name china')} />}
      {<Column dataField="ISABLEINPUT" caption={translate('ISABLEINPUT', 'Is Able Input')} visible={false} showInColumnChooser={false} />}
      {<Column dataField="ISCUSTOMER" caption={translate('ISCUSTOMER', 'Is Customer')} visible={false} showInColumnChooser={false} />}
      {<Column dataField="ISABLETYPE" caption={translate('ISABLETYPE', 'Is Able Type')} visible={false} showInColumnChooser={false} />}
      {<Column dataField="ISUSERADD" caption={translate('ISUSERADD', 'Is User Add')} visible={false} showInColumnChooser={false} />}
      {<Column dataField="LEVEL" caption={translate('LEVEL', 'Level')} visible={false} showInColumnChooser={false} />}
      {<Column dataField="DECISION" caption={translate('DECISION', 'Decision')} visible={false} showInColumnChooser={false} />}
      {<Column dataField="DESTINATION_ACC_CD" caption={translate('DESTINATION_ACC_CD', 'Destination Account Code')} visible={false} showInColumnChooser={false} />}
    </>
  );
}