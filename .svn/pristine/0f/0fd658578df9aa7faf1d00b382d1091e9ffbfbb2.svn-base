import { CompanyInfo } from "@/types/companyInfo";
import { getAccessToken } from "@/lib/login";
import API_BASE_URL from "../config/apiConfig";
import axios from './axiosClient';



// GET all (optionally filtered by customer code or id) and localized by language
export async function getCompanyInfo(
  customerIdentifier?: string,
  lang?: string
): Promise<{ data: CompanyInfo[]; labels: Record<string,string> }> {
  try {
    const params: any = {};
    
    if (lang) params.lang = lang;
    const resp = await axios.get(`${API_BASE_URL}/CompanyInfo/Get`, { params });

    // log for debugging
    console.debug("getCompanyInfo response status", resp.status);
    console.debug("getCompanyInfo response data", resp.data);

    if (resp.status !== 200) {
      throw new Error(`Unexpected HTTP status ${resp.status}`);
    }

    // the controller may return several wrapper shapes. normalize to { data, labels }
    const payload = resp.data;
    if (!payload || typeof payload !== "object") {
      throw new Error("Invalid response format from getCompanyInfo");
    }

    // possible shapes:
    // { data: [...], labels: {...} }
    // { Data: { data: [...], labels: {...} } }
    // { data: { data: [...], labels: {...} } }
    const inner = payload.Data ?? payload.data ?? payload;

    // If inner is the array itself, there are no labels
    if (Array.isArray(inner)) {
      return { data: inner as CompanyInfo[], labels: {} };
    }

    const list = inner.data ?? inner;
    const labels = inner.labels ?? {};

    if (!Array.isArray(list)) {
      throw new Error("Response did not contain an array of customer exts");
    }

    return { data: list as CompanyInfo[], labels: labels as Record<string,string> };
  } catch (err: any) {
    console.error("Error in getCompanyInfoCompanyInfo:", err);
    if (err.response) {
      console.error("Response data:", err.response.data);
      console.error("Response status:", err.response.status);
    }
    throw err; // rethrow so caller can handle
  }
}

