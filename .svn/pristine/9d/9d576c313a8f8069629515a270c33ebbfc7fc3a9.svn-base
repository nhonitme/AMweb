  noteType: ChitType,
): ChitInfo => ({
  CHIT_ID: null,
  COMPANY_CD: "",
  CHIT_CD: "",
  CHIT_NO: "",
  CHIT_YMD: new Date(),
  CHIT_TYPE: noteType,
  AMOUNT: 0,
  PAYER_INFO: "",
  ISDEL: false,
  USERID: "",
  CREATE_BY: "",
  CREATE_DT: null,
  MODIFY_BY: "",
  MODIFY_DT: null,
  IS_LOCK: false,
  ISEXCEL: false,
  EMAIL_EPAY: "",
  IS_CONFIRMED: false,
  NOTE: "",
