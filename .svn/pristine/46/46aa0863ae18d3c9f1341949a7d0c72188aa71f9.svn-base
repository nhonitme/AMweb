import React, { useContext } from "react";
import DataGrid, {
    Paging,
    Pager,
    FilterRow,
    HeaderFilter,
    FilterBuilderPopup,
    FilterPanel,
    SearchPanel,
    Selection,
    ColumnChooser,
    ColumnChooserSearch,
    Column,
} from "devextreme-react/data-grid";
import { LanguageContext } from "@/lib/i18nLoader";

import type {
    Column as ColumnType,
    InitializedEvent,
    ToolbarPreparingEvent,
    ContextMenuPreparingEvent,
    RowInsertingEvent,
    RowUpdatingEvent,
    RowRemovingEvent,
    EditingStartEvent,
    InitNewRowEvent,
    SelectionChangedEvent,
    RowClickEvent,
    RowDblClickEvent,
    CellPreparedEvent,
} from "devextreme/ui/data_grid";

import "./BaseDataGrid.scss";

interface BaseDataGridProps<T> {
    dataSource: T[];
    keyExpr: string;
    /** fields removed when copying a row (in addition to keyExpr) */
    copyExcludeFields?: string[];
    columns?: (string | ColumnType<T, unknown>)[];
    children?: React.ReactNode;
    actionButtons?: boolean;
    /** Position of the action buttons column */
    actionButtonsPosition?: 'start' | 'end';
    onRowDblClick?: (e: RowDblClickEvent) => void;
    onRowClick?: (e: RowClickEvent) => void;

    onInitialized?: (e: InitializedEvent) => void;
    onToolbarPreparing?: (e: ToolbarPreparingEvent) => void;
    onContextMenuPreparing?: (e: ContextMenuPreparingEvent) => void;
    onRowInserting?: (e: RowInsertingEvent) => void;
    onRowUpdating?: (e: RowUpdatingEvent) => void;
    onRowRemoving?: (e: RowRemovingEvent) => void;
    onEditingStart?: (e: EditingStartEvent) => void;
    onInitNewRow?: (e: InitNewRowEvent) => void;
    onSelectionChanged?: (e: SelectionChangedEvent) => void;
}

const onToolbarPreparing = (e: ToolbarPreparingEvent) => {
    e.toolbarOptions.items = e.toolbarOptions.items?.filter(
        (item) => item.name !== 'addRowButton' && item.name !== 'columnChooserButton'
    );
};

export function BaseDataGrid<T>({
  dataSource,
  keyExpr,
  copyExcludeFields = [],
  children,
  actionButtons = false,
  actionButtonsPosition = 'end',
  onRowDblClick,
  onRowClick,
  onInitialized,
  onContextMenuPreparing,
  onRowInserting,
  onRowUpdating,
  onRowRemoving,
  onEditingStart,
  onInitNewRow,
  onSelectionChanged,
}: BaseDataGridProps<T>) {
  const { translate } = useContext(LanguageContext) as {
    translate: (key: string, fallback?: string) => string;
  };
  const t = (key: string, fallback?: string) => (translate ? translate(key, fallback) : fallback ?? key);

    const stripFields = (obj: Record<string, unknown>, fields: string[] | Set<string>) => {
        if (!obj || typeof obj !== 'object') return;
        const upper = new Set(Array.from(fields).map((f) => f.toUpperCase()));
        Object.keys(obj).forEach((k) => {
            if (upper.has(k.toUpperCase())) {
                delete obj[k];
            }
        });
    };

    const copyDataRef = React.useRef<Record<string, unknown> | null>(null);

    const handleRowClickInternal = (e: RowClickEvent) => {
      const comp = e.component;
      if (comp) {
        const key = e.key;
        if (comp.isRowSelected(key)) {
          comp.deselectRows(key);
        } else {
          comp.selectRows(key, true);
        }
      }
      onRowClick && onRowClick(e);
    };

    const handleContextMenuPreparingInternal = (e: ContextMenuPreparingEvent) => {
      if (e.row && e.row.rowType === "data") {
        const items: Array<{ text: string; onItemClick: () => void }> = [
          {
            text: t('Update', 'Update'),
            onItemClick: () => {
              e.component?.editRow(e.row!.rowIndex);
            },
          },
          {
            text: t('Delete', 'Delete'),
            onItemClick: () => {
              e.component?.deleteRow(e.row!.rowIndex);
            },
          },
        ];
        items.push({
          text: t('Copy', 'Copy'),
          onItemClick: () => {
            if (e.row?.data) {
              const clone = { ...(e.row.data as Record<string, unknown>) };
              if (keyExpr) stripFields(clone, [keyExpr]);
              if (copyExcludeFields && copyExcludeFields.length) stripFields(clone, copyExcludeFields);
              copyDataRef.current = clone;
              e.component?.addRow();
            }
          },
        });
        e.items = items;
      }
      onContextMenuPreparing && onContextMenuPreparing(e);
    };

    return (
      <div className="data-grid-container h-full w-full">
        <DataGrid
          dataSource={dataSource}
          keyExpr={keyExpr}
          width="100%"
          height="100%"

          onSelectionChanged={onSelectionChanged}
          showBorders
          columnAutoWidth
          showColumnHeaders={true}
          allowColumnResizing={true}
          allowColumnReordering={true}
          hoverStateEnabled
          rowAlternationEnabled
          onRowClick={handleRowClickInternal}
          onRowDblClick={onRowDblClick}
          onInitialized={onInitialized}
          onToolbarPreparing={onToolbarPreparing}
          onContextMenuPreparing={handleContextMenuPreparingInternal}
          onRowInserting={onRowInserting}
          onRowUpdating={onRowUpdating}
          onRowRemoving={onRowRemoving}
          onEditingStart={onEditingStart}
          onInitNewRow={(e) => {
            if (copyDataRef.current) {
              const data = (e.data ?? {}) as Record<string, unknown>;
              Object.assign(data, copyDataRef.current);
              if (keyExpr) stripFields(data, [keyExpr]);
              if (copyExcludeFields && copyExcludeFields.length) stripFields(data, copyExcludeFields);
              copyDataRef.current = null;
              e.data = data;
            }
            onInitNewRow && onInitNewRow(e);
          }}
        >
            <HeaderFilter visible />
            <FilterRow showOperationChooser />
            <SearchPanel placeholder={t('Search...', 'Search...')} />
            <FilterPanel visible />
            <FilterBuilderPopup />

            <Selection
                mode="multiple"
                selectAllMode="allPages"
                showCheckBoxesMode="always"
            />

            <ColumnChooser enabled mode="select">
                <ColumnChooserSearch
                    enabled
                    timeout={800}
                    editorOptions={{
                        placeholder: t("Search column", "Search column"),
                        mode: "text",
                    }}
                />
            </ColumnChooser>

            <Paging defaultPageSize={20} />
            <Pager
                visible={true}
                showPageSizeSelector={true}
                allowedPageSizes={[20, 50, 100]}
                showInfo={true}
                showNavigationButtons={true}
                infoText={translate ? translate("PAGE_TEXT", "Page {0} / {1} ({2} rows)") : "Page {0} / {1} ({2} rows)"}
            />

            {actionButtons && actionButtonsPosition === 'start' && (
                <Column type="buttons" width={100} />
            )}
            {children}
            {actionButtons && actionButtonsPosition === 'end' && (
                <Column type="buttons" width={100} />
            )}
          
            </DataGrid></div>
    );
}
