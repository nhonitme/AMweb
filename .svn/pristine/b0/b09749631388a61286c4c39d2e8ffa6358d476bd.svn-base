import axios from './axiosClient';
import API_BASE_URL from '../config/apiConfig';
import type { ManagementInfo, ManagementInfoRequest } from '@/types/managementInfo';

const BASE_URL = `${API_BASE_URL}/ManagementInfo`;
const EXCEL_BASE_URL = `${API_BASE_URL}/ExcelImportExport`;

export async function getManagementInfos(
  mgCd?: string,
  id?: number,
  lang?: string,
  translate?: boolean,
): Promise<{ data: ManagementInfo[]; labels: Record<string, string> }> {
  const params: any = {};
  if (mgCd) params.MG_CD = mgCd;
  if (id) params.ID = id;
  if (lang) params.lang = lang;
  if (translate) params.translate = true;

  const resp = await axios.get(`${BASE_URL}/Get`, { params });
  const payload = resp.data;
  const inner = payload?.Data ?? payload?.data ?? payload;

  const data = Array.isArray(inner?.data) ? inner.data : Array.isArray(inner) ? inner : [];
  const labels = inner?.labels ?? {};
  return { data, labels };
}

export async function createManagementInfo(
  payload: Partial<ManagementInfoRequest>,
  lang?: string,
): Promise<{ data: ManagementInfo; message?: string }> {
  const url = `${BASE_URL}/Create${lang ? `?lang=${encodeURIComponent(lang)}` : ''}`;
  const resp = await axios.post(url, payload);
  return resp.data;
}

export async function updateManagementInfo(
  payload: Partial<ManagementInfoRequest>,
  lang?: string,
): Promise<{ data: ManagementInfo; message?: string }> {
  const url = `${BASE_URL}/Update${lang ? `?lang=${encodeURIComponent(lang)}` : ''}`;
  const resp = await axios.put(url, payload);
  return resp.data;
}

export async function deleteManagementInfo(
  id: number,
  mgCd?: string,
): Promise<any> {
  const params: any = { ID: id };
  if (mgCd) params.MG_CD = mgCd;
  const resp = await axios.delete(`${BASE_URL}/Delete`, { params });
  return resp.data;
}

export async function exportManagementInfoExcel(
  mgCd?: string,
  lang?: string,
): Promise<Blob> {
  const params: any = {};
  if (mgCd) params.MG_CD = mgCd;
  if (lang) params.lang = lang;
  const resp = await axios.get(`${EXCEL_BASE_URL}/management/export`, {
    params,
    responseType: 'blob',
  });
  return resp.data;
}

export async function importManagementInfoExcel(
  file: File,
  lang?: string,
): Promise<any> {
  const form = new FormData();
  form.append('file', file);
  const url = `${EXCEL_BASE_URL}/management/import${lang ? `?lang=${encodeURIComponent(lang)}` : ''}`;
  const resp = await axios.post(url, form);
  return resp.data;
}
