      <Column dataField="PRODUCT_VAT_AMOUNT" caption={t("PRODUCT_VAT_AMOUNT", "Output VAT")} dataType="number" format="#,##0.00" width={140} />
      <Column dataField="VAT_CHIT_NO" caption={t("VAT_CHIT_NO", "Sales invoice no")} width={160} />
      <AccountingColumns createAccEditor={createAccEditor} t={t} />
