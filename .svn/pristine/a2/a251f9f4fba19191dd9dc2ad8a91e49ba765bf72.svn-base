import * as React from "react";
import SelectBox, { ISelectBoxOptions, SelectBoxRef } from "devextreme-react/select-box";

import { cn } from "@/lib/utils";

export interface SearchableSelectProps extends ISelectBoxOptions {
  className?: string;
}

export function searchableSelectOptions(options: ISelectBoxOptions = {}): ISelectBoxOptions {
  return {
    searchEnabled: true,
    searchMode: "contains",
    showClearButton: false,
    stylingMode: "outlined",
    ...options,
  };
}

const SearchableSelect = React.forwardRef<SelectBoxRef, SearchableSelectProps>(
  ({ className, searchEnabled = true, searchMode = "contains", stylingMode = "outlined", ...props }, ref) => {
    return (
      <SelectBox
        ref={ref}
        className={cn(className)}
        searchEnabled={searchEnabled}
        searchMode={searchMode}
        stylingMode={stylingMode}
        {...props}
      />
    );
  },
);

SearchableSelect.displayName = "SearchableSelect";

export default SearchableSelect;
