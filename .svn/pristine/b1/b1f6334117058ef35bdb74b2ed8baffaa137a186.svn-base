// Helper function to get icon component from icon name
const getIconComponent = (iconName: string): React.ReactNode => {
  return iconMap[iconName] || iconMap[iconName.toLowerCase()] || <MenuIcon size={16} />;
};

// Recursive function to find path to a node in menu tree
function findPathToNode(
  nodeList: MenuTreeNode[],
  targetId: string,
  path: string[] = []
): string[] | null {
  for (const node of nodeList) {
    const currentPath = [...path, node.id];
    if (node.id === targetId) return currentPath;
    if (node.children && node.children.length > 0) {
      const found = findPathToNode(node.children, targetId, currentPath);
      if (found) return found;
    }
  }
  return null;
}

// Function to find all paths to matched nodes (for search)
function findAllPathsToMatchedNodes(
  nodeList: MenuTreeNode[],
  term: string,
  path: string[] = []
): string[][] {
  let result: string[][] = [];
  for (const node of nodeList) {
    const currentPath = [...path, node.id];
    const nodeMatch = node.name.toLowerCase().includes(term.toLowerCase());
    let childMatched = false;
    if (node.children && node.children.length > 0) {
      const childPaths = findAllPathsToMatchedNodes(node.children, term, currentPath);
      if (childPaths.length > 0) {
        result = result.concat(childPaths);
        childMatched = true;
      }
    }
    if (nodeMatch || childMatched) {
      result.push(currentPath);
    }
  }
  return result;
}

// Recursive SidebarMenuNode component for rendering menu items
function SidebarMenuNode({
  node,
  level = 0,
  expandedPath,
  onMenuSelect,
  location,
  setExpandedPath,
  isSearching = false,
}: {
  node: MenuTreeNode;
  level?: number;
  expandedPath: string[];
  onMenuSelect: (menuItem: MenuTreeNode) => void;
  location: ReturnType<typeof useLocation>;
  setExpandedPath: React.Dispatch<React.SetStateAction<string[]>>;
  isSearching?: boolean;
}) {
  const hasChildren = !!node.children && node.children.length > 0;
  const isExpanded = isSearching ? true : expandedPath[level] === node.id;

  // Determine if this node or any of its children is active
  const isActive = (() => {
    if (expandedPath[expandedPath.length - 1] === node.id) return true;
    if (level === 1 && hasChildren) {
      if (expandedPath[1] === node.id) return true;
      return node.children?.some(sub => expandedPath.includes(sub.id));
    }
    if (level === 0 && hasChildren) {
      if (expandedPath[0] === node.id) return true;
      return node.children?.some(sub => expandedPath.includes(sub.id) || (sub.children && sub.children.some(third => expandedPath.includes(third.id))));
    }
    return false;
  })();

  const handleToggle = (e: React.MouseEvent) => {
    e.stopPropagation();
    
    if (isExpanded) {
      setExpandedPath(expandedPath.slice(0, level));
    } else {
      const newPath = expandedPath.slice(0, level);
      setExpandedPath([...newPath, node.id]);
    }
  };

  const handleClick = () => {
    // If node has a route path and is not disabled, navigate to it
    if (node.routePath && !node.isDisabled) {
      onMenuSelect(node);
    } else if (hasChildren) {
      // If no route but has children, toggle expansion
      if (isExpanded) {
        setExpandedPath(expandedPath.slice(0, level));
      } else {
        const newPath = expandedPath.slice(0, level);
        setExpandedPath([...newPath, node.id]);
      }
    }
  };

  // Highlight searchTerm in text
  const highlightText = (text: string, term: string) => {
    if (!term) return text;
    const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    const parts = text.split(regex);
    return parts.map((part, i) =>
      regex.test(part)
        ? <span key={i} className="bg-yellow-200 text-red-700 font-bold">{part}</span>
        : part
    );
  };

  return (
    <div className="relative">
      {hasChildren && isExpanded && (
        <div
          className="absolute top-7 bottom-0 left-2 border-l border-dashed border-gray-400 z-0"
          style={{ left: `${level * 24 + 8}px` }}
        />
      )}
      <div className="relative flex items-center" style={{ paddingLeft: `${level * 24}px` }}>
        {level > 0 && (
          <span
            className="absolute left-0 top-1/2 -translate-y-1/2 border-t border-dashed border-gray-400 w-4 z-10"
            style={{
              left: `${(level - 1) * 24 + 8}px`
            }}
          />
        )}
        <button
          onClick={handleClick}
          disabled={node.isDisabled}
          className={[
            'relative z-10 w-full flex items-center justify-between px-3',
            level > 0 ? 'py-1.5' : 'py-2.5',
            'text-left rounded-lg transition-all duration-200',
            node.isDisabled ? 'opacity-50 cursor-not-allowed' : '',
            level === 0 && isActive && !isSearching
              ? 'bg-red-600 text-white font-bold'
              : isActive && !isSearching
                ? 'text-red-700 font-bold'
                : hasChildren
                  ? 'text-gray-700 hover:bg-gray-50'
                  : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
          ].join(' ')}
        >
          <div className="flex items-center space-x-3">
            {level === 0 && node.icon && (
              <span className={isActive && !isSearching ? 'flex-shrink-0 text-white' : 'flex-shrink-0 text-gray-400'}>
                {getIconComponent(node.icon)}
              </span>
            )}
            <span className={`text-sm ${level > 0 ? 'font-normal' : 'font-medium'}${level > 0 && isActive && !isSearching ? ' text-red-700 font-bold' : ''}`}>
              <>{highlightText(
                node.name,
                (typeof window !== 'undefined' && window.document)
                  ? (document.querySelector('input[placeholder="Tìm kiếm menu..."]') as HTMLInputElement)?.value || ''
                  : ''
              )}</>
            </span>
          </div>
        </button>
        {hasChildren && (
          <button
            onClick={handleToggle}
            className={`absolute right-3 top-1/2 transform -translate-y-1/2 p-1 rounded transition-all duration-200 z-20 ${
              level === 0 && isActive && !isSearching 
                ? 'text-white hover:bg-white hover:bg-opacity-20' 
                : 'text-gray-400 hover:text-red-400 hover:bg-gray-100'
            }`}
          >
            <ChevronDown 
              size={14} 
              className={`transition-transform duration-200 ${isExpanded ? 'rotate-180' : ''}`}
            />
          </button>
        )}
      </div>
      {hasChildren && isExpanded && (
        <div className="relative">
          {node.children!.map((child) => (
            <SidebarMenuNode
              key={child.id}
              node={child}
              level={level + 1}
              expandedPath={expandedPath}
              onMenuSelect={onMenuSelect}
              location={location}
              setExpandedPath={setExpandedPath}
              isSearching={isSearching}
            />
          ))}
        </div>
      )}
    </div>
  );
}

export default function Sidebar({
  menuTree,
  activeMenu,
  onMenuSelect,
  isCollapsed,
  isMobile = false,
  loading,
}: SidebarProps) {
  const [expandedPath, setExpandedPath] = useState<string[]>([]);
  const [searchTerm, setSearchTerm] = useState('');
  const [isSidebarHovered, setSidebarHovered] = useState(false);
  const [originalMenuState, setOriginalMenuState] = useState<{ expandedPath: string[]; activeMenu: string | null } | null>(null);
  // const [menuTree, setMenuTree] = useState<MenuTreeNode[]>([]);
  // const [loading, setLoading] = useState(true);
  // const [error, setError] = useState<string | null>(null);
  const location = useLocation();
  const searchInputRef = React.useRef<HTMLInputElement>(null);

  // Fetch menu data from API on component mount
  // useEffect(() => {
  //   const loadMenuData = async () => {
  //     try {
  //       setLoading(true);
  //       setError(null);
  //       const menuItems = await fetchMenuList();
  //       const tree = buildMenuTree(menuItems);
  //       setMenuTree(tree);
  //     } catch (err) {
  //       console.error('Failed to load menu:', err);
  //       setError('Không thể tải menu. Vui lòng thử lại.');
  //     } finally {
  //       setLoading(false);
  //     }
  //   };

  //   loadMenuData();
  // }, []);

  // Listen for Ctrl+K to focus search input
  React.useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        searchInputRef.current?.focus();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  const handleMenuSelect = (menuItem: MenuTreeNode) => {
    const path = findPathToNode(menuTree, menuItem.id);
    if (path) {
      setExpandedPath(path);
      onMenuSelect(menuItem); // Truyền menuItem lên cho App.tsx
      if (searchTerm && !originalMenuState) {
        setOriginalMenuState({ expandedPath, activeMenu });
      }
    } else {
      // Có thể gọi onMenuSelect với một giá trị rỗng nếu cần
    }
  };

  // Filter menu items based on search term
  const filterMenuItems = (nodes: MenuTreeNode[]): MenuTreeNode[] => {
    if (!searchTerm) return nodes;

    const allPaths = findAllPathsToMatchedNodes(nodes, searchTerm, []);
    const idsToShow = new Set<string>();
    allPaths.forEach(path => path.forEach(id => idsToShow.add(id)));

    const filterNodes = (items: MenuTreeNode[]): MenuTreeNode[] => {
      return items
        .filter(item => idsToShow.has(item.id))
        .map(item => ({
          ...item,
          children: item.children ? filterNodes(item.children) : undefined,
        }));
    };

    return filterNodes(nodes);
  };

  const filteredMenuTree = filterMenuItems(menuTree);

  // Save original menu state when search starts, restore when cleared
  useEffect(() => {
    if (searchTerm) {
      if (!originalMenuState) {
        setOriginalMenuState({ expandedPath, activeMenu });
      }
      const allMatchedPaths: string[] = [];
      const paths = findAllPathsToMatchedNodes(menuTree, searchTerm, []);
      paths.forEach(path => {
        path.forEach(nodeId => {
          if (!allMatchedPaths.includes(nodeId)) {
            allMatchedPaths.push(nodeId);
          }
        });
      });
      setExpandedPath(allMatchedPaths);
    } else {
      if (originalMenuState) {
        setExpandedPath(originalMenuState.expandedPath);
        setOriginalMenuState(null);
      }
    }
  }, [searchTerm, activeMenu, expandedPath, menuTree, originalMenuState]);

  // When activeMenu changes, open parent menus
  useEffect(() => {
    if (!searchTerm && activeMenu) {
      const path = findPathToNode(menuTree, activeMenu);
      if (path) setExpandedPath(path);
    }
  }, [activeMenu, searchTerm, menuTree]);

  // Show loading state
  // if (loading) {
  //   return (
  //     <div className={`bg-white border-r border-gray-200 ${isMobile ? 'w-64' : isCollapsed ? 'w-16' : 'w-64'} h-screen flex items-center justify-center`}>
  //       <div className="text-gray-500 text-sm">Đang tải menu...</div>
  //     </div>
  //   );
  // }

  // // Show error state
  // if (error) {
  //   return (
  //     <div className={`bg-white border-r border-gray-200 ${isMobile ? 'w-64' : isCollapsed ? 'w-16' : 'w-64'} h-screen flex items-center justify-center`}>
  //       <div className="text-red-500 text-sm text-center px-4">{error}</div>
  //     </div>
  //   );
  // }

  // Hiển thị chỉ báo tải nếu loading là true
  if (loading) {
    return (
      <div className="flex items-center justify-center h-full bg-gray-800 text-white">
        Loading...
      </div>
    );
  }

  // Collapsed sidebar with hover-to-expand floating overlay
  if (isCollapsed && !isMobile) {
    return (
      <>
        <div
          className="bg-white border-r border-gray-200 w-16 h-screen flex flex-col z-20"
          onMouseEnter={() => setSidebarHovered(true)}
          onMouseLeave={() => setSidebarHovered(false)}
          style={{ position: 'relative' }}
        >
          <div className="p-3 border-b border-gray-200 flex-shrink-0">
            <div className="w-10 h-10 bg-red-600 rounded-lg flex items-center justify-center">
              <span className="text-white font-bold text-sm">AM</span>
            </div>
          </div>
          <nav className="flex-1 overflow-y-auto p-2">
            <div className="space-y-1">
              {menuTree.map((item) => {
                const hasChildren = !!item.children && item.children.length > 0;
                const isActive = (() => {
                  if (activeMenu === item.id) return true;
                  if (hasChildren) {
                    if (item.children?.some(sub => sub.id === activeMenu)) return true;
                    return item.children?.some(sub => sub.children?.some(third => third.id === activeMenu));
                  }
                  return false;
                })();
                return (
                  <button
                    key={item.id}
                    onClick={() => onMenuSelect(item)}
                    disabled={item.isDisabled}
                    className={`w-full flex items-center justify-center p-3 rounded-lg transition-all duration-200 ${
                      isActive
                        ? 'bg-red-50 text-red-700'
                        : 'text-gray-700 hover:bg-gray-50'
                    } ${item.isDisabled ? 'opacity-50 cursor-not-allowed' : ''}`}
                    title={item.name}
                  >
                    <div className={`${isActive ? 'text-red-600' : 'text-gray-400'}`}>
                      {getIconComponent(item.icon)}
                    </div>
                  </button>
                );
              })}
            </div>
          </nav>
        </div>
        {/* Floating expanded sidebar overlay on hover */}
        {isSidebarHovered && (
          <div
            className="fixed left-0 top-0 h-screen w-64 bg-white border-r border-gray-200 shadow-lg z-[99] flex flex-col"
            onMouseEnter={() => setSidebarHovered(true)}
            onMouseLeave={() => setSidebarHovered(false)}
            style={{ pointerEvents: 'auto' }}
          >
            {/* Header */}
            <div className="p-4 border-b border-gray-200 flex-shrink-0">
              <div className="flex items-center space-x-3">
                <div className="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
                  <span className="text-white font-bold text-sm">AM</span>
                </div>
                <div>
                  <h1 className="text-lg font-bold text-gray-900">AMnote</h1>
                  <p className="text-xs text-gray-500">Phần mềm kế toán</p>
                </div>
              </div>
            </div>
            {/* Search */}
            <div className="p-3 border-b border-gray-200 flex-shrink-0">
              <div className="relative">
                <Search size={16} className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" />
                <input
                  type="text"
                  placeholder="Tìm kiếm menu..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  className="w-full pl-9 pr-9 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent focus:border-red-500 hover:border-gray-300 active:border-gray-300 outline-none"
                />
                {searchTerm && (
                  <button
                    type="button"
                    className="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 focus:outline-none"
                    onClick={() => setSearchTerm("")}
                    tabIndex={-1}
                    aria-label="Xóa tìm kiếm"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                )}
              </div>
            </div>
            {/* Menu Groups */}
            <nav className="flex-1 overflow-y-auto p-2">
              <div className="space-y-1">
                {filteredMenuTree.map((item) => (
                  <SidebarMenuNode
                    key={item.id}
                    node={item}
                    level={0}
                    expandedPath={expandedPath}
                    onMenuSelect={handleMenuSelect}
                    location={location}
                    setExpandedPath={setExpandedPath}
                    isSearching={!!searchTerm}
                  />
                ))}
              </div>
            </nav>
            {/* User Info */}
            <div className="p-4 border-t border-gray-200 flex-shrink-0">
              <div className="flex items-center space-x-3">
                <div className="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center">
                  <span className="text-white text-sm font-medium">ML</span>
                </div>
                <div className="flex-1 min-w-0">
                  <div className="text-sm font-medium text-gray-900 truncate">Nguyễn Mỹ Liên</div>
                  <div className="text-xs text-gray-500 truncate">Kế toán trưởng</div>
                </div>
              </div>
            </div>
          </div>
        )}
      </>
    );
  }

  return (
    <div
      className={`bg-white border-r border-gray-200 ${
        isMobile ? 'w-64' : 'w-64'
      } h-screen flex flex-col`}
    >
      {/* Header */}
      <div className="p-4 border-b border-gray-200 flex-shrink-0">
        <div className="flex items-center space-x-3">
          <div className="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
            <span className="text-white font-bold text-sm">AM</span>
          </div>
          <div>
            <h1 className="text-lg font-bold text-gray-900">AMnote</h1>
            <p className="text-xs text-gray-500">Phần mềm kế toán</p>
          </div>
        </div>
      </div>

      {/* Search */}
      <div className="p-3 border-b border-gray-200 flex-shrink-0">
        <div className="relative">
          <Search size={16} className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" />
          <input
            ref={searchInputRef}
            type="text"
            placeholder="Tìm kiếm menu..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full pl-9 pr-9 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent focus:border-red-500 hover:border-gray-300 active:border-gray-300 outline-none"
          />
          {searchTerm && (
            <button
              type="button"
              className="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 focus:outline-none"
              onClick={() => setSearchTerm("")}
              tabIndex={-1}
              aria-label="Xóa tìm kiếm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          )}
        </div>
      </div>
      
      {/* Menu Groups */}
      <nav className="flex-1 overflow-y-auto p-2">
        <div className="space-y-1">
          {filteredMenuTree.map((item) => (
            <SidebarMenuNode
              key={item.id}
              node={item}
              level={0}
              expandedPath={expandedPath}
              onMenuSelect={handleMenuSelect}
              location={location}
              setExpandedPath={setExpandedPath}
              isSearching={!!searchTerm}
            />
          ))}
        </div>
      </nav>
      {/* User Info */}
      <div className="p-4 border-t border-gray-200 flex-shrink-0">
        <div className="flex items-center space-x-3">
          <div className="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center">
            <span className="text-white text-sm font-medium">ML</span>
          </div>
          <div className="flex-1 min-w-0">
            <div className="text-sm font-medium text-gray-900 truncate">Nguyễn Mỹ Liên</div>
            <div className="text-xs text-gray-500 truncate">Kế toán trưởng</div>
          </div>
        </div>
      </div>
    </div>
  );
}