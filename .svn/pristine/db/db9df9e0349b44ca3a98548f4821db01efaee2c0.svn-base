import DateBox, { IDateBoxOptions } from "devextreme-react/date-box";
import type { ValueChangedEvent } from "devextreme/ui/date_box";

type DatePickerValue = Date | string | number | null | undefined;

export interface DatePickerProps {
  id?: string;
  value?: DatePickerValue;
  placeholder?: string;
  isLoading?: boolean;
  onValueChanged?: (value: Date | null) => void;
  showClearButton?: boolean;
  type?: "date" | "datetime";
  displayFormat?: string;
}

function normalizeDateValue(value: DatePickerValue): Date | null {
  if (value == null || value === "") {
    return null;
  }

  const nextValue = value instanceof Date ? value : new Date(value);
  return Number.isNaN(nextValue.getTime()) ? null : nextValue;
}

export function dateEditorOptions(options: {
  type?: "date" | "datetime";
  displayFormat?: string;
  placeholder?: string;
  showClearButton?: boolean;
}): IDateBoxOptions {
  return {
    type: options.type ?? "date",
    displayFormat: options.displayFormat ?? "dd/MM/yyyy",
    placeholder: options.placeholder,
    showClearButton: options.showClearButton ?? true,
    elementAttr: { class: "standard-date-picker" },
  };
}

export default function DatePicker({
  id,
  value,
  placeholder,
  isLoading,
  onValueChanged,
  showClearButton = true,
  type = "date",
  displayFormat = "dd/MM/yyyy",
}: DatePickerProps) {
  return (
    <div>
      <style>{`.standard-date-picker .dx-clear-button{width:18px;height:18px;padding:0;margin:0}.standard-date-picker .dx-clear-button .dx-icon{font-size:12px}.standard-date-picker .dx-texteditor-input{caret-color:auto}`}</style>
      {isLoading ? (
        <div className="w-full rounded-lg border bg-gray-50 px-3 py-2 text-sm text-gray-500">Dang tai...</div>
      ) : (
        <DateBox
          id={id}
          value={normalizeDateValue(value)}
          onValueChanged={(event: ValueChangedEvent) => {
            onValueChanged?.(normalizeDateValue(event.value as DatePickerValue));
          }}
          placeholder={placeholder}
          type={type}
          displayFormat={displayFormat}
          showClearButton={showClearButton}
          elementAttr={{ class: "standard-date-picker" }}
        />
      )}
    </div>
  );
}
