import React, { useContext } from "react";
import { Column, RequiredRule,AsyncRule } from "devextreme-react/data-grid";
import { LanguageContext } from '@/lib/i18nLoader';
import { checkExists } from "@/api/storeAPI";

const validateStoreCd = async (e: { value: unknown; data?: any }) => {
  const storeCd = String(e.value ?? "").trim();

  if (!storeCd) {
    return true;
  }

  try {
    const storeId = e.data?.STORE_ID ?? 0;
    const res = await checkExists(
      storeId,
      storeCd
    );

    return {
      isValid: !res.Data,
    };
  } catch (err: any) {
    console.error("Error in getStore:", err);
  }
    return {
      isValid: false,
      message: "Không kiểm tra được dữ liệu",
    };
};

export const StoreColumns: React.FC = () => {
  const { translate } = useContext(LanguageContext) as { translate: (k: string, f?: string) => string };
  return (
    <>
      <Column 
        type="buttons"
        width={100}
        showInColumnChooser={false}
        //caption={translate('MSG_BTNSELECT4', 'Choose')}
      />
  
      {<Column dataField="STORE_ID" caption={translate('STORE_ID', 'Store ID')}  visible={true}  showInColumnChooser={false}/>}
      {<Column dataField="STORE_CD" caption={translate('STORE_CD', 'Store Code')} >
        <RequiredRule message={translate ? translate("MSG_MUST_ITEM", "STORE_CD không được để trống") : "STORE_CD không được để trống"} />
        <AsyncRule message={translate ? translate("MsgEqualCode", "STORE_CD đã tồn tại") : "STORE_CD đã tồn tại"} validationCallback={validateStoreCd} />
      </Column>}

      {<Column dataField="STORE_NM_VIET" caption={translate('STORE_NM_VIET', 'Store Name (VN)')}>
        <RequiredRule message={translate ? translate("MSG_MUST_ITEM", "ACCTITLE_NM_VIET không được để trống") : "ACCTITLE_NM_VIET không được để trống"} />
      </Column>}  
      {<Column dataField="STORE_NM_ENG" caption={translate('STORE_NM_ENG', 'Store Name (ENG)')} />}
      {<Column dataField="STORE_NM_KOR" caption={translate('STORE_NM_KOR', 'Store Name (KOR)')} />}
      {<Column dataField="STORE_NM_CHINA" caption={translate('STORE_NM_CHINA', 'Store Name (CHINA)')} />}
      {<Column dataField="STORE_KIND_CD" caption={translate('STORE_KIND_CD', 'Kind')} />}
      {<Column dataField="STORE_KIND_ID" caption={translate('MSG_STOREKINDID', 'Kind')} visible={false}  showInColumnChooser={false} />}
      {<Column dataField="STORE_KIND_NM_VIET" caption={translate('STORE_KIND_NM_VIET', 'STORE_KIND_NM_VIET')} />}
      {<Column dataField="STORE_KIND_NM_ENG" caption={translate('STORE_KIND_NM_ENG', 'STORE_KIND_NM_ENG')} />}
      {<Column dataField="STORE_KIND_NM_KOR" caption={translate('STORE_KIND_NM_KOR', 'STORE_KIND_NM_KOR')} />}
      {<Column dataField="STORE_KIND_NM_CHINA" caption={translate('STORE_KIND_NM_CHINA', 'STORE_KIND_NM_CHINA')} />}
    </>
  );
}