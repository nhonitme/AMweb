import { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';
import App from './App.tsx';
import './index.css';
import { initMessagesDevex, LanguageProvider } from '@/lib/i18nLoader';
// Ensure axios interceptors are registered before the app mounts
import './api/axiosClient';

// Initialize messages from cache if available, then mount the app.
initMessagesDevex();

createRoot(document.getElementById('root')!).render(
  <StrictMode>
    <LanguageProvider>
      <App />
    </LanguageProvider>
  </StrictMode>
);
