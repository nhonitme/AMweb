import axios from './axiosClient'
import API_BASE_URL from '../config/apiConfig'
import type { UserInfoApi } from '@/types/userInfo'

const BASE_URL = `${API_BASE_URL}/UserInfo`

function normalizeResponse<T>(resp: any): { data: T; message?: string } {
  if (!resp || typeof resp !== 'object') {
    throw new Error('Invalid API response')
  }
  const payload = resp.data ?? resp
  return {
    data: payload.data ?? payload,
    message: payload.message ?? resp.message ?? '',
  }
}

export async function getUserInfos(userId?: string, lang?: string): Promise<{ data: UserInfoApi[]; labels: Record<string, string> }> {
  const params: any = {}
  if (userId) params.USERID = userId
  if (lang) params.lang = lang

  const resp = await axios.get(`${BASE_URL}/Get`, { params })
  const payload = resp.data
  const inner = payload?.Data ?? payload?.data ?? payload

  const data = Array.isArray(inner?.data) ? inner.data : Array.isArray(inner) ? inner : []
  const labels = inner?.labels ?? {}

  return { data, labels }
}

export async function createUserInfo(
  payload: Partial<UserInfoApi>,
  lang?: string,
): Promise<{ data: UserInfoApi; message?: string }> {
  const url = `${BASE_URL}/Create${lang ? `?lang=${encodeURIComponent(lang)}` : ''}`
  const resp = await axios.post(url, payload)
  return normalizeResponse<UserInfoApi>(resp)
}

export async function updateUserInfo(
  payload: Partial<UserInfoApi>,
  lang?: string,
): Promise<{ data: UserInfoApi; message?: string }> {
  const url = `${BASE_URL}/Update${lang ? `?lang=${encodeURIComponent(lang)}` : ''}`
  const resp = await axios.put(url, payload)
  return normalizeResponse<UserInfoApi>(resp)
}

export async function deleteUserInfo(userId: string): Promise<{ success: boolean; message?: string }> {
  const params: any = { USERID: userId }
  const resp = await axios.delete(`${BASE_URL}/Delete`, { params })
  const payload = resp.data
  return { success: payload?.success ?? true, message: payload?.message }
}
