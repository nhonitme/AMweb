import { useContext, useMemo } from "react";
import DataGrid, { Column, Editing, FilterPanel, FilterRow, HeaderFilter, Paging, Pager, SearchPanel } from "devextreme-react/data-grid";
import { Button } from "@/components/ui/button";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from "@/components/ui/dialog";
import { LanguageContext } from "@/lib/i18nLoader";

export type PermissionRow = {
  MENU_CODE: string;
  CAN_VIEW?: boolean;
  CAN_ADD?: boolean;
  CAN_EDIT?: boolean;
  CAN_DELETE?: boolean;
  CAN_PRINT?: boolean;
  CAN_EXPORT?: boolean;
  CAN_IMPORT?: boolean;
  CAN_APPROVE?: boolean;
} & Record<string, unknown>;

export type PermissionsDialogProps = {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  title?: string;
  description?: string;
  userLabel?: string;
  permissions: PermissionRow[];
  onChange: (newPermissions: PermissionRow[]) => void;
  onSave: () => void;
  onCancel: () => void;
  canSave?: boolean;
  loading?: boolean;
};

export function PermissionsDialog({
  open,
  onOpenChange,
  title = "Permissions",
  description,
  userLabel,
  permissions,
  onChange,
  onSave,
  onCancel,
  canSave = false,
  loading = false,
}: PermissionsDialogProps) {
  const { translate } = useContext(LanguageContext) as {
    translate: (key: string, fallback?: string) => string;
  };

  const rows = permissions ?? [];

  const permissionKeys = [
    "CAN_VIEW",
    "CAN_ADD",
    "CAN_EDIT",
    "CAN_DELETE",
    "CAN_PRINT",
    "CAN_EXPORT",
    "CAN_IMPORT",
    "CAN_APPROVE",
  ] as const;

  const rowsWithLabels = useMemo(
    () =>
      rows.map((row) => {
        const isAll = permissionKeys.every((key) => Boolean(row[key]));
        return {
          ...row,
          MENU_LABEL: translate(row.MENU_CODE, row.MENU_CODE),
          CAN_ALL: isAll,
        };
      }),
    [rows, translate],
  );

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="w-full max-w-full sm:max-w-[50vw] bg-white shadow-xl">
        <DialogHeader className="pb-2 border-b border-slate-200">
          <div className="flex flex-col gap-2 w-full">
            <DialogTitle className="text-base sm:text-lg font-semibold">
              {title}
              {userLabel ? ` — ${userLabel}` : ""}
            </DialogTitle>
            {description ? (
              <DialogDescription className="text-sm text-muted-foreground">
                {description}
              </DialogDescription>
            ) : null}
            <div className="text-xs text-muted-foreground">
              {rows.length} permission{rows.length === 1 ? "" : "s"} loaded
            </div>
          </div>
        </DialogHeader>

        <div className="mt-4 flex h-[50vh] flex-col overflow-hidden rounded-lg border border-slate-200 bg-white">
          {loading ? (
            <div className="flex h-full items-center justify-center text-sm text-muted-foreground">
              Loading permissions...
            </div>
          ) : rows.length === 0 ? (
            <div className="flex h-full items-center justify-center text-sm text-muted-foreground">
              No permissions found.
            </div>
          ) : (
            <div className="flex-1 min-h-0 overflow-auto">
              <DataGrid
                dataSource={rowsWithLabels}
                keyExpr="MENU_CODE"
                width="100%"
                height="100%"
                showBorders
                columnAutoWidth={false}
                allowColumnResizing
                allowColumnReordering
                hoverStateEnabled
                rowAlternationEnabled
                onRowUpdating={(e) => {
                  if (!e.key) return;

                  const idx = rows.findIndex((r) => r.MENU_CODE === e.key);
                  if (idx < 0) return;

                  const base = { ...rows[idx], ...e.newData } as PermissionRow;

                  if (typeof e.newData.CAN_ALL === "boolean") {
                    permissionKeys.forEach((key) => {
                      base[key] = e.newData.CAN_ALL as boolean;
                    });
                    // remove temporary flag before saving
                    delete (base as Record<string, unknown>).CAN_ALL;
                  }

                  const unchanged = permissionKeys.every((key) => base[key] === rows[idx][key]);
                  if (unchanged) return;

                  const updated = [...rows];
                  updated[idx] = base;
                  onChange(updated);
                }}
              >
                <Paging defaultPageSize={200} />
                <Pager visible={false} />
                <HeaderFilter visible={false} />
                <FilterRow visible={false} />
                <FilterPanel visible={false} />
                <SearchPanel
                  placeholder={translate("Search...")}
                  searchExpr={["MENU_CODE", "MENU_LABEL"]}
                  visible
                />
                <Editing mode="cell" allowUpdating />

                <Column
                  dataField="MENU_LABEL"
                  caption={translate("Menu Code")}
                  allowEditing={false}
                  width={240}
                />
                <Column
                  dataField="CAN_ALL"
                  caption={translate("Toàn quyền")}
                  dataType="boolean"
                  width={100}
                />
                <Column dataField="CAN_VIEW" caption="View" dataType="boolean" width={80} />
                <Column dataField="CAN_ADD" caption="Add" dataType="boolean" width={80} />
                <Column dataField="CAN_EDIT" caption="Edit" dataType="boolean" width={80} />
                <Column dataField="CAN_DELETE" caption="Delete" dataType="boolean" width={80} />
                <Column dataField="CAN_PRINT" caption="Print" dataType="boolean" width={80} />
                <Column dataField="CAN_EXPORT" caption="Export" dataType="boolean" width={80} />
                <Column dataField="CAN_IMPORT" caption="Import" dataType="boolean" width={80} />
                <Column dataField="CAN_APPROVE" caption="Approve" dataType="boolean" width={80} />
              </DataGrid>
            </div>
          )}
        </div>

        <DialogFooter className="mt-4 justify-end border-t border-slate-200 pt-3">
          <div className="flex gap-2">
            <Button stylingMode="outlined" text="Cancel" onClick={onCancel} />
            <Button text="Save" onClick={onSave} disabled={!canSave} />
          </div>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
