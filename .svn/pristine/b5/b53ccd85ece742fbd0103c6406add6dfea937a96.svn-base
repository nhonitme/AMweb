export type ShortcutActionCode = (typeof SHORTCUT_ACTIONS)[keyof typeof SHORTCUT_ACTIONS]
export type ShortcutGroup = "system" | "form" | "grid" | "navigation"
export type ShortcutScope = "global" | "page" | "popup"

export type ShortcutDefinition = {
  action: ShortcutActionCode
  combo: ShortcutKeyCombo
  label: string
  labelKey?: string
  description?: string
  descriptionKey?: string
  group: ShortcutGroup
  scope: ShortcutScope
  icon?: string
  permissionKey?: string
  visible?: boolean
  allowInInput?: boolean
  commitActiveEditor?: boolean
  preventDefault?: boolean
  stopPropagation?: boolean
}

export const SHORTCUT_GROUP_ORDER: ShortcutGroup[] = ["system", "navigation", "form", "grid"]

