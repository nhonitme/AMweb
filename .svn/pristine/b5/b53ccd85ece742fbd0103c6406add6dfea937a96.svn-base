export function translateShortcutDefinition(
  shortcut: ShortcutDefinition,
  translate: (key: string, fallback: string) => string,
): ShortcutDefinition {
  return {
    ...shortcut,
    label: shortcut.labelKey ? translate(shortcut.labelKey, shortcut.label) : shortcut.label,
    description: shortcut.descriptionKey
      ? translate(shortcut.descriptionKey, shortcut.description ?? "")
      : shortcut.description,
  }
}

export function getSharedShortcutDefinition(
  action: ShortcutActionCode,
  translate?: (key: string, fallback: string) => string,
) {
  const shortcut = SHARED_SHORTCUT_DEFINITIONS[action]
  return translate && shortcut ? translateShortcutDefinition(shortcut, translate) : shortcut
}

export function getSharedShortcutDefinitions(
  actions?: ShortcutActionCode[],
  translate?: (key: string, fallback: string) => string,
) {
  const items = actions?.length
    ? actions.map((action) => SHARED_SHORTCUT_DEFINITIONS[action]).filter(Boolean)
    : Object.values(SHARED_SHORTCUT_DEFINITIONS)

  const translated = translate
    ? items.map((item) => translateShortcutDefinition(item, translate))
    : items

  return [...translated].sort((left, right) => {
    const groupOrder =
      SHORTCUT_GROUP_ORDER.indexOf(left.group) - SHORTCUT_GROUP_ORDER.indexOf(right.group)
    if (groupOrder !== 0) {
      return groupOrder
    }

    return left.label.localeCompare(right.label)
  })
}
