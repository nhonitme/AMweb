import React, { useEffect, useRef, useState, useMemo, useContext } from "react";
import { LoadPanel } from "devextreme-react";
import notify from 'devextreme/ui/notify';
import {
  RowInsertingEvent,
  RowUpdatingEvent,
  RowRemovingEvent,
  RowDblClickEvent,
} from "devextreme/ui/data_grid";
import { Editing, Popup as DxPopup } from 'devextreme-react/data-grid';
import { Form as DxForm } from 'devextreme-react/data-grid';
import { Item as DxItem } from 'devextreme-react/form';
import type dxDataGrid from "devextreme/ui/data_grid";

import DxPage from "@/dx/DxPage";
import { BaseDataGrid } from "@/components/datagrid/BaseDataGrid";
import { GridToolbar } from "@/components/toolbar/GridToolbar";
import ExcelImportModal from "@/components/modals/ExcelImportModal";
import { confirm } from "devextreme/ui/dialog";
import { customerImportConfig } from './Columns/customerImportConfig';
import { LanguageContext } from '@/lib/i18nLoader';
import axios from '@/api/axiosClient';
import { CustomerColumns } from "./Columns/CustomerColumns";

import ReadonlySelect, { readonlySelectEditorOptions } from '@/components/ui/ReadonlySelect'
import { Input } from '@/components/ui/input'
import { Checkbox } from '@/components/ui/checkbox'
import DatePicker from '@/components/ui/calendar'

import type { CustomerExt } from "@/types/customerExt";
import {
  getCustomerExts,
  createCustomerExt,
  updateCustomerExt,
  deleteCustomerExt,
  exportCustomerExtExcel,
  importCustomerExtExcel,
} from "@/api/customerExtApi";
import { getSysCodes, SysCode } from '@/api/sysCodeService'
import { dateEditorOptions } from '@/components/ui/calendar'
import "./CustomerExtPage.scss"

function stripFields(obj: Record<string, unknown>, fields: Set<string>) {
  if (!obj || typeof obj !== 'object') return;
  const upper = new Set(Array.from(fields).map((f) => f.toUpperCase()));
  Object.keys(obj).forEach((k) => {
    if (upper.has(k.toUpperCase())) {
      delete obj[k];
    }
  });
}


type TKey = string | number;

type EditorTemplateData<TValue = unknown> = {
  value?: TValue;
  setValue?: (value: TValue) => void;
  component?: dxDataGrid<CustomerExt, TKey>;
  data?: CustomerExt;
  row?: { data?: CustomerExt; rowIndex?: number };
  key?: TKey;
};

type FormItemConfig = {
  dataField: string;
  label?: { text: string };
  editorType?: string;
  editorOptions?: Record<string, unknown>;
  editorTemplate?: (data: EditorTemplateData) => JSX.Element;
  colSpan?: number;
};

type FormGroup = { caption: string; items: FormItemConfig[] };

type RowInsertingEventWithPromise = RowInsertingEvent<CustomerExt, TKey> & { promise?: Promise<void> };
type RowUpdatingEventWithPromise = RowUpdatingEvent<CustomerExt, TKey> & { promise?: Promise<void> };
type RowRemovingEventWithPromise = RowRemovingEvent<CustomerExt, TKey> & { promise?: Promise<void> };

export default function CustomerExtPage() {
  const [loading, setLoading] = useState(true);
  const [gridData, setGridData] = useState<CustomerExt[]>([]);
  const { lang, translate } = useContext(LanguageContext) as { translate: (k: string, f?: string) => string; lang: string };
  const popupTitle = translate ? translate('CUSTOMER', 'Customer Ext') : 'Customer Ext';
  const [colLabels, setColLabels] = useState<Record<string,string>>({});

  const gridRef = useRef<dxDataGrid<CustomerExt, TKey> | null>(null);
  const [isExcelModalOpen, setIsExcelModalOpen] = useState(false);
  const [isEditPopupOpen, setIsEditPopupOpen] = useState(false);

  const getPopupFocusableElements = (container: HTMLElement | null) => {
    if (!container) return [] as HTMLElement[];
    const selector = 'input, select, textarea, button, [tabindex]:not([tabindex="-1"])';
    return Array.from(container.querySelectorAll<HTMLElement>(selector)).filter(
      (el) => !el.hasAttribute('disabled') && el.offsetParent !== null,
    );
  };

  useEffect(() => {
    if (!isEditPopupOpen) return;

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' || event.key === 'Esc') {
        const grid = gridRef.current;
        grid?.cancelEditData?.();
        grid?.closeEditCell?.();
        event.preventDefault();
        return;
      }

      if (event.key !== 'Tab') return;

      const popup = document.querySelector('.dx-popup-content.dx-state-active') as HTMLElement | null;
      const focusable = getPopupFocusableElements(popup);
      if (!focusable.length) return;

      const current = document.activeElement as HTMLElement | null;
      const idx = current ? focusable.indexOf(current) : -1;
      if (idx === -1) return;

      event.preventDefault();
      const next = event.shiftKey ? (idx - 1 + focusable.length) % focusable.length : (idx + 1) % focusable.length;
      focusable[next]?.focus();
    };

    window.addEventListener('keydown', onKeyDown, true);
    return () => window.removeEventListener('keydown', onKeyDown, true);
  }, [isEditPopupOpen]);

  const excludedFields = useMemo(() => new Set<string>([
    'COMPANY_CD', 
    'CUSTOMER_EXT_CD',
    'CUSTOMER_ID', 'CUSTOMER_EXT_ID', 'EXT_CUSTOMER_ID',
    'CREATED_AT', 'CREATEDAT',
    'UPDATED_AT', 'UPDATEDAT',    
    'ISDEL', 
  ]), []);


  const [sysCodes, setSysCodes] = useState<SysCode[]>([]);
  const [sysCodeLabels, setSysCodeLabels] = useState<Record<string,string>>({});

  const customerTypeDisplay = useMemo(() => {
    return sysCodes.reduce<Record<string, string>>((acc, code) => {
      const label = sysCodeLabels[code.CODE_NAME] ?? code.CODE_NAME ?? code.CODE_CD;
      acc[code.CODE_CD] = translate ? translate(code.CODE_CD, label) : label;
      return acc;
    }, {});
  }, [sysCodes, sysCodeLabels, translate]);

  const gridDataWithLabels = useMemo(() => {
    return gridData.map((row) => ({
      ...row,
      CUSTOMER_TYPE_NAME:
        customerTypeDisplay[String(row.CUSTOMER_TYPE ?? "")] ?? (row.CUSTOMER_TYPE ?? ""),
    }));
  }, [gridData, customerTypeDisplay]);

  const formGroups = useMemo(() => {
    const groups: Record<string, FormGroup> = {
      basic: { caption: "Basic", items: [] },
      contact: { caption: "Contact", items: [] },
      address: { caption: "Address", items: [] },
      id: { caption: "Identification", items: [] },
      tax: { caption: "Tax / Bank", items: [] },
      other: { caption: "Other", items: [] },
    };

    const fieldKeys = Object.keys(colLabels || {}).filter((f) => !excludedFields.has(f.toUpperCase()));
    const basicKeys = new Set(["CUSTOMER_EXT_CD","CUSTOMER_CD","CUSTOMER_NM_VIET","BUYER_NM","CUSTOMER_USER_CD","OWNER_NM","CUSTOMER_RECEIVE"]);
    const contactKeys = new Set(["TEL","FAX","EMAIL","CUSTOMER_RECEIVE"]);
    const addressKeys = new Set(["ADDRESS","ADDRESS_DO","ADDRESS_RECEIVE","ZIP_CODE"]);
    const idKeys = new Set(["IDNUMBER","SSN","SHCHIEU","PLACE_ISSUE","DATE_ISSUE"]);
    const taxKeys = new Set(["TAX_CD","TAX_CD_RECEIVE","BANK_CD","PAYMENT_TERM","BRN"]);

    fieldKeys.forEach((f) => {
      const name = f.toUpperCase();
      const rawCaption = colLabels[f] ?? f;
      const caption = translate ? translate(f, rawCaption) : rawCaption;
      const item: FormItemConfig = { dataField: f, label: { text: caption } };

      if (/DATE(_|).*|\bDATE\b|DATEISSUE|DATE_ISSUE/i.test(name)) {
        item.editorType = 'dxDateBox';
        item.editorOptions = dateEditorOptions({
          type: 'date',
          displayFormat: 'dd/MM/yyyy',
          placeholder: caption,
          showClearButton: true,
        });
        item.editorTemplate = (data: EditorTemplateData<Date | string | number | null>) => (
          <DatePicker
            value={data.value as Date | string | number | null}
            placeholder={caption}
            onValueChanged={(e) => data.setValue?.(e.value)}
            showClearButton={true}
            type="date"
            displayFormat="dd/MM/yyyy"
          />
        );
      }

      if (/CUSTOMER.*TYPE|TYPE.*CUSTOMER|\bTYPE\b/i.test(name)) {
        item.editorType = 'dxSelectBox';
        item.editorOptions = readonlySelectEditorOptions({
          dataSource: sysCodes,
          valueExpr: 'CODE_CD',
          displayExpr: (it: SysCode | null | undefined) => (it ? (sysCodeLabels[it.CODE_NAME] ?? it.CODE_NAME ?? it.CODE_CD) : ''),
          placeholder: caption,
          showClearButton: true,
          showDropDownButton: true,
        });
        item.editorTemplate = (data: EditorTemplateData<string | number | null>) => (
          <ReadonlySelect
            dataSource={sysCodes}
            value={data.value as string | number | null}
            valueExpr="CODE_CD"
            displayExpr={(it: SysCode | null | undefined) => (it ? (sysCodeLabels[it.CODE_NAME] ?? it.CODE_NAME ?? it.CODE_CD) : '')}
            placeholder={caption}
            showClearButton={true}
            showDropDownButton={true}
            onValueChanged={(e) => data.setValue?.(e.value)}
          />
        );
      }

      if (/^ISUSE$|^IS_/.test(name) || /ISTEMP|ISDEL|IS_/.test(name)) {
        item.editorType = 'dxCheckBox';
        item.editorTemplate = (data: EditorTemplateData<boolean | null>) => (
          <Checkbox
            value={data.value as boolean | null}
            onValueChanged={(e) => data.setValue?.(e.value)}
          />
        );
      }

      if (!item.editorTemplate) {
        item.editorTemplate = (data: EditorTemplateData<string | number | null>) => (
          <Input
            value={data.value as string | number | null}
            onValueChanged={(e) => data.setValue?.(e.value)}
          />
        );
      }

      if (basicKeys.has(name) || /^(CUSTOMER_|CUSTOMER$|EXT$)/.test(name)) {
        groups.basic.items.push(item);
        return;
      }
      if (contactKeys.has(name) || /TEL|FAX|EMAIL/.test(name)) {
        groups.contact.items.push(item);
        return;
      }
      if (addressKeys.has(name) || /ADDRESS|ZIP/.test(name)) {
        groups.address.items.push(item);
        return;
      }
      if (idKeys.has(name) || /IDNUMBER|SSN|SHCHIEU/.test(name)) {
        groups.id.items.push(item);
        return;
      }
      if (taxKeys.has(name) || /TAX|BANK|PAYMENT|BRN/.test(name)) {
        groups.tax.items.push(item);
        return;
      }

      groups.other.items.push(item);
    });

    const result = ["basic", "contact", "address", "id", "tax", "other"].map((k) => groups[k]).filter(g => g.items.length > 0);
    return result;
  }, [colLabels, sysCodes, sysCodeLabels, translate]);




  function CustomerExtForm() {
    const tabs = formGroups.map((g) => ({
      title: g.caption,
      colCount: 2,
      items: g.items.map((it) => ({
        dataField: it.dataField,
        editorType: it.editorType,
        editorOptions: it.editorOptions,
        label: { text: translate(it.dataField, (it.label && it.label.text) || it.dataField) },
        colSpan: it.colSpan,
      })),
    }));

    return (
      <div className="customer-ext-form">
        <DxForm
          colCount={1}
          labelLocation="top"
          width="100%"
        >
          <DxItem itemType="tabbed" tabs={tabs} />
        </DxForm>
      </div>
    );
  }


  const handleImport = async (
    rows: Array<Record<string, unknown>>,
    method: "add" | "update" | "overwrite",
    file?: File
  ) => {
    const normalize = (r: Record<string, unknown>) => {
      const clone = { ...r } as Record<string, unknown>;
      delete clone.CUSTOMER_TYPE_NAME;
      return clone as Partial<CustomerExt>;
    };

    try {
      if (file) {
        await importCustomerExtExcel(file, lang);
      } else {
        if (method === "overwrite" || method === "add") {
          for (const r of rows) {
            await createCustomerExt(normalize(r));
          }
        } else if (method === "update") {
          for (const r of rows) {
            if ((r as Partial<CustomerExt>).CUSTOMER_ID) {
              await updateCustomerExt(normalize(r) as CustomerExt);
            }
          }
        }
      }
    } catch (err) {
      console.error("Import error", err);
      let msg = translate ? translate('Import failed','Import failed') : 'Import failed';
      const axiosErr = err as { response?: { data?: unknown } };
      const data = axiosErr.response?.data;
      if (typeof data === 'string') {
        msg += `: ${data}`;
      } else if (typeof data === 'object' && data !== null) {
        const maybe = data as Record<string, unknown>;
        if (typeof maybe.Message === 'string') {
          msg += `: ${maybe.Message}`;
        } else if (typeof maybe.error === 'string') {
          msg += `: ${maybe.error}`;
        }
      }
      notify(msg, 'error', 5000);
    }
    await loadData();
  };

  const handleToolbarDelete = async () => {
    const selectedKeys = (gridRef.current?.getSelectedRowKeys() || []) as Array<string | number>;
    const keys = selectedKeys.map(String);

    if (!keys.length) {
      notify(
        translate ? translate('KeyM_Nothing_Selected', 'No rows selected') : 'No rows selected',
        'warning',
        2000
      );
      return;
    }

    const result = await confirm(
      translate
        ? translate('MSG_CONFIRM_DELETE_RECORD', 'Are you sure you want to delete {0} record?').replace(
            '{0}',
            String(keys.length),
          )
        : `Are you sure you want to delete ${keys.length} record?`,
      translate ? translate('MSG_CONFIRM_DELETE', 'Confirm delete') : 'Confirm delete',
    );

    if (!result) return;

    try {
      await deleteCustomerExt(keys);
      notify(
        translate ? translate('MSG_DELETE_SUCCESS', 'Deleted selected rows successfully') : 'Deleted selected rows successfully',
        'success',
        2000,
      );
      await loadData();
      gridRef.current?.clearSelection();
    } catch (err) {
      console.error('Bulk delete error', err);
      notify(
        translate ? translate('MSG_DELETE_ERROR', 'Delete failed') : 'Delete failed',
        'error',
        2000,
      );
    }
  };

  const handleExportExcel = async () => {
    try {
      const selectedKeys = (gridRef.current?.getSelectedRowKeys() || []) as Array<string | number>;
      const customerId = selectedKeys.length ? String(selectedKeys[0]) : undefined;
      const blob = await exportCustomerExtExcel(customerId);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `customer_ext_${new Date().toISOString().replace(/[:.-]/g, '')}.xlsx`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch (err) {
      console.error('Export error', err);
      notify(
        translate ? translate('Export failed','Export failed') : 'Export failed',
        'error',
        3000
      );
    }
  };


  const handleRowDblClick = (e: RowDblClickEvent<CustomerExt, TKey>) => {
    if (!gridRef.current) {
      console.warn('gridRef not initialized when double-click occurred');
      return;
    }

    let idx: number | undefined | null = e?.rowIndex;
    if (idx === undefined && e?.row) {
      idx = e.row.rowIndex;
    }
    if ((idx === undefined || idx === null) && e?.key !== undefined) {
      idx = gridRef.current.getRowIndexByKey(e.key as TKey);
    }
    if (idx !== undefined && idx !== null && idx !== -1) {
      gridRef.current.editRow(idx);
    } else {
      console.warn('unable to determine row index from dblclick event', e);
    }
  };

  const loadData = async () => {
    setLoading(true);
    try {
      axios.defaults.headers.common['Accept-Language'] = lang;
      const resp = await getCustomerExts(undefined, lang);
      setGridData(resp.data);
      setColLabels(resp.labels);
      gridRef.current?.clearSelection();
    } catch (err) {
      console.error("Failed to load customer ext data", err);
      const axiosErr = err as { response?: { status?: number; data?: unknown }; message?: string };
      if (axiosErr.response) {
        console.error("Server response:", axiosErr.response.status, axiosErr.response.data);
        notify(
          `Load error: ${axiosErr.response.status ?? ''} ${JSON.stringify(axiosErr.response.data)}`,
          'error',
          5000,
        );
      } else {
        notify(`Load error: ${axiosErr.message ?? String(err)}`, 'error', 5000);
      }
    } finally {
      setLoading(false);
    }
  };



  const onRowInserting = (e: RowInsertingEventWithPromise) => {
    e.promise = (async () => {
      try {
        const row = { ...(e.data ?? {}) } as Record<string, unknown>;
        stripFields(row, excludedFields);

        if (Object.keys(row).length === 0) {
          notify(
            translate ? translate('MSG_EMPTY_ROW', 'Cannot insert empty row') : 'Cannot insert empty row',
            'warning',
            3000,
          );
          return;
        }

        await createCustomerExt(row as Partial<CustomerExt>);
        await loadData();
      } catch (err) {
        notify(`Insert error: ${String(err)}`, 'error', 3000);
      } finally {
        if (e.component) (e.component as dxDataGrid<CustomerExt, TKey>).cancelEditData();
      }
    })();
  };

  const onRowUpdating = (e: RowUpdatingEventWithPromise) => {
    e.promise = (async () => {
      try {
        const payload = { ...(e.oldData ?? {}), ...(e.newData ?? {}) } as Partial<CustomerExt> & Record<string, unknown>;

        if (!payload.CUSTOMER_ID && e.key !== undefined) {
          payload.CUSTOMER_ID = e.key as TKey;
        }

        if (!payload.CUSTOMER_ID) {
          console.warn('update called without CUSTOMER_ID', e, payload);
          return;
        }

        const toStrip = new Set(excludedFields);
        toStrip.delete('CUSTOMER_ID');
        stripFields(payload, toStrip);
        await updateCustomerExt(payload as CustomerExt);
        await loadData();
      } catch (err) {
        notify(`Update error: ${String(err)}`, 'error', 3000);
      } finally {
        if (e.component) (e.component as dxDataGrid<CustomerExt, TKey>).cancelEditData();
      }
    })();
  };

  const onRowRemoving = (e: RowRemovingEventWithPromise) => {
    e.promise = (async () => {
      try {
        await deleteCustomerExt(String(e.key));
        await loadData();
      } catch (err) {
        notify(`Delete error: ${err}`, 'error', 3000);
      }
    })();
  };

  const loadedLang = React.useRef<string | null>(null);

  useEffect(() => {
    if (loadedLang.current !== lang) {
      loadedLang.current = lang;
      loadData();
      (async () => {
        try {
          const l = localStorage.getItem('lang') || 'VIET';
          const resp = await getSysCodes('CUSTOMER_TYPE', l);
          setSysCodes(resp.data || []);
          setSysCodeLabels(resp.labels || {});
        } catch (err) {
          console.error('Failed to load sys codes for editors', err);
        }
      })();
    }
  }, [lang]);

  return (
    <DxPage>
      <GridToolbar
        title={translate ? translate('CUSTOMER', 'Customer Ext List') : 'Customer Ext List'}
        gridRef={gridRef}
        onRefresh={loadData}
        onDelete={handleToolbarDelete}
        onImport={() => setIsExcelModalOpen(true)}
        onExportPdf={() => alert("Export to PDF not implemented")}
        onExportXlsx={handleExportExcel}
      />
      <ExcelImportModal
        isOpen={isExcelModalOpen}
        onClose={() => setIsExcelModalOpen(false)}
        onImport={handleImport}
        existingData={gridData}
        config={customerImportConfig}
        serverImport={true}
        hideUpdateOverwrite={true}
      />

      <div className="data-grid-container">
        <BaseDataGrid<CustomerExt>
          dataSource={gridDataWithLabels}
          keyExpr="CUSTOMER_ID"
          copyExcludeFields={Array.from(excludedFields)}
          actionButtons={true}
          actionButtonsPosition="start"
          onRowDblClick={handleRowDblClick}
          onInitialized={(e) => {
            gridRef.current = e.component ?? null;
          }}
          onRowInserting={onRowInserting}
          onRowUpdating={onRowUpdating}
          onRowRemoving={onRowRemoving}
          onInitNewRow={(e) => {
            const row = { ...(e.data ?? {}) } as Record<string, unknown>;
            row.ISUSE = true;
            row.DATE_ISSUE = null;
            delete row.CUSTOMER_TYPE_NAME;
            stripFields(row, excludedFields);
          }}
        >
          <CustomerColumns />
          <Editing
            mode="popup"
            allowUpdating={true}
            allowAdding={true}
            allowDeleting={true}
            confirmDelete={true}
            startEditAction="dblClick"
          >
            <DxPopup
              key={lang}
              title={popupTitle}
              showTitle={true}
              width="90%"
              maxWidth={1000}
              deferRendering={true}
              closeOnOutsideClick={true}
              closeOnEscape={true}
              onShown={() => setIsEditPopupOpen(true)}
              onHidden={() => setIsEditPopupOpen(false)}
            />
            <CustomerExtForm />
          </Editing>
        </BaseDataGrid>

        <LoadPanel
          shadingColor="rgba(0, 0, 0, 0.4)"
          visible={loading}
          showIndicator={true}
          shading={true}
          showPane={true}
        />
      </div>
      
    </DxPage>
  );
}
