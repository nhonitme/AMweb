import { useContext } from "react"
import { Column } from "devextreme-react/data-grid"

import { LanguageContext } from "@/lib/i18nLoader"

export function ChitNoteDetailColumns() {
  const { translate } = useContext(LanguageContext) as {
    translate?: (key: string, fallback?: string) => string
  }

  const t = (key: string, fallback: string) => (translate ? translate(key, fallback) : fallback)

  return (
    <>
      <Column dataField="CHIT_ID" visible={false} />
      <Column dataField="CHITDETAIL_ID" visible={false} />
      <Column dataField="CHITDETAIL_CD" visible={false} />
      <Column dataField="CHIT_YMD" visible={false} />
      <Column dataField="CUSTOMER_ID"  visible={false} />
      <Column dataField="CUSTOMER_CD" caption={t("CUSTOMER", "Khách hàng")} width={200} />
      <Column dataField="CUSTOMER_NM_VIET" caption={t("CUSTOMER_NM", "Tên khách hàng")} minWidth={200} />
      <Column dataField="DEBIT" caption={t("DEBIT", "Tài khoản nợ")} width={100} />
      <Column dataField="DEBIT_NM_VIET" caption={t("ACC_NM_DEBIT", "Tên TK nợ")} width={200} />
      <Column dataField="CREDIT" caption={t("CREDIT", "Tài khoản có")} width={100} />
      <Column dataField="CREDIT_NM_VIET" caption={t("ACC_NM_CREDIT", "Tên TK có")} width={200} />
      <Column dataField="AMOUNT" caption={t("AMOUNT", "Số tiền")} dataType="number" format="#,##0.00" minWidth={130} />
      <Column dataField={"DETAIL_DESCRIPTION_VIET"} caption={t("DESCRIPTION2", "Diễn giải")} minWidth={220} />
    </>
  )
}

export default ChitNoteDetailColumns
