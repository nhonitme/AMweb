import axios from "@/api/axiosClient";

export interface SysCode {
  CODE_ID: number;
  CODE_TYPE: string;
  CODE_CD: string;
  CODE_NAME: string;
  SORT_ORDER: number;
  IS_ACTIVE: number;
  ISDEL: string;
  CREATED_AT: string;
  UPDATED_AT: string;
}

export interface SysCodesResponse {
  data: SysCode[];
  labels: Record<string, string>;
}

export async function getSysCodes(codeType?: string, lang?: string): Promise<SysCodesResponse> {
  try {
    console.debug('[sysCodeService] requesting sys-codes', { codeType, lang })
    const res = await axios.get('/system/sys-codes', { params: { codeType, lang } });
    const apiPayload = res.data;
    console.debug('[sysCodeService] response', apiPayload)
    const payload = apiPayload?.Data ?? apiPayload?.data ?? apiPayload;
    return payload as SysCodesResponse;
  } catch (err: any) {
    // normalize error
    const msg = err?.response?.data?.Message || err.message || 'Failed to fetch sys codes';
    throw new Error(msg);
  }
}
