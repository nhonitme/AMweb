import React, { useContext } from "react";
import { Column } from "devextreme-react/data-grid";
import { LanguageContext } from '@/lib/i18nLoader';

export const ProductColumns: React.FC = () => {
  const { translate } = useContext(LanguageContext) as { translate: (k: string, f?: string) => string };

  return (
    <>
      <Column 
        type="buttons"
        width={100}
      />
      <Column dataField="PRODUCT_ID" caption={translate('PRODUCT_ID', 'ID')} />
      <Column dataField="PRODUCT_CD" caption={translate('PRODUCT_CD', 'Product Code')} />
      <Column dataField="PRODUCT_NM" caption={translate('PRODUCT_NM', 'Product Name')} />
      <Column dataField="PRODUCT_NM_ENG" caption={translate('PRODUCT_NM_ENG', 'Name (ENG)')} />
      <Column dataField="PRODUCT_NM_KOR" caption={translate('PRODUCT_NM_KOR', 'Name (KOR)')} />
      <Column dataField="PRODUCT_KIND_CD" caption={translate('PRODUCT_KIND_CD', 'Kind')} />
      <Column dataField="STORE_CD" caption={translate('STORE_CD', 'Store Code')} />
      <Column dataField="UNIT_CD" caption={translate('UNIT_CD', 'Unit')} />
      <Column dataField="DIVISION" caption={translate('DIVISION', 'Division')} />
      <Column dataField="DIVISION_C99" caption={translate('DIVISION_C99', 'Division C99')} />
      <Column dataField="UNIT_PRICE_CC" caption={translate('UNIT_PRICE_CC', 'Unit Price (CC)')} />
      <Column dataField="UNIT_PRICE_FC" caption={translate('UNIT_PRICE_FC', 'Unit Price (FC)')} />
      <Column dataField="FC_TYPE" caption={translate('FC_TYPE', 'FC Type')} />
      <Column dataField="EX_RATE" caption={translate('EX_RATE', 'Exchange Rate')} />
      <Column dataField="VAT_RATE" caption={translate('VAT_RATE', 'VAT Rate')} />
      <Column dataField="SUMMARY" caption={translate('SUMMARY', 'Summary')} />
      <Column dataField="ORIGIN" caption={translate('ORIGIN', 'Origin')} />
      <Column dataField="CUSTOMS_CODE" caption={translate('CUSTOMS_CODE', 'Customs Code')} />
      <Column dataField="ISUSE" caption={translate('ISUSE', 'Is Use')} />
      <Column dataField="USERID" caption={translate('USERID', 'User ID')} />
    </>
  );
};
