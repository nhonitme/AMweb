import React, { useContext, useMemo } from "react";
import { Form as DxForm } from "devextreme-react/data-grid";
import { Item as DxItem } from "devextreme-react/form";
import { Input } from "@/components/ui/input";
import { LanguageContext } from "@/lib/i18nLoader";

interface UserInfoFormProps {
  colLabels?: Record<string, string>;
}

export default function UserInfoForm({ colLabels = {} }: UserInfoFormProps) {
  const { translate } = useContext(LanguageContext) as { translate: (k: string, f?: string) => string; lang: string };
  const t = (k: string, f: string) => (translate ? translate(k, f) : f);

  const label = (field: string, fallback: string) => colLabels[field] ?? t(field, fallback);

  const items = useMemo(() => {
    return [
      {
        dataField: "USERID",
        label: { text: label("USERID", "User ID") },
      },
      {
        dataField: "PASSWD",
        label: { text: label("PASSWD", "Password") },
        editorType: "dxTextBox",
        editorOptions: {
          mode: "password",
          value: "",
        },
      },
    ];
  }, [colLabels, translate]);

  return (
    <div className="user-info-form">
      <DxForm colCount={2} labelLocation="top" width="100%">
        {items.map((item) => (
          <DxItem
            key={item.dataField}
            dataField={item.dataField}
            editorType={item.editorType as any}
            editorOptions={item.editorOptions as any}
            label={item.label}
          />
        ))}
      </DxForm>
    </div>
  );
}
