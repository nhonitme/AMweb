import { useCallback, useContext, useEffect, useMemo, useRef, useState } from "react"
import LoadPanel from "devextreme-react/load-panel"
import type dxDataGrid from "devextreme/ui/data_grid"
import type { InitializedEvent, RowDblClickEvent, SelectionChangedEvent } from "devextreme/ui/data_grid"
import { confirm } from "devextreme/ui/dialog"
import notify from "devextreme/ui/notify"

import { createChitNote, deleteChitNote, exportChitNoteExcel, getChitNotes, importChitNoteExcel, updateChitNote } from "@/api/chitNoteApi"
import DetailGrid from "@/components/datagrid/DetailGrid"
import PageGrid from "@/components/datagrid/PageGrid"
import ExcelImportModal from "@/components/modals/ExcelImportModal"
import Pagination from "@/components/table/Pagination"
import { GridToolbar } from "@/components/toolbar/GridToolbar"
import DxPage from "@/dx/DxPage"
import { LanguageContext } from "@/lib/i18nLoader"
import { getCurrentCompanyCd, getCurrentUserId } from "@/lib/login"
import type { ChitNote, ChitNoteDetail, ChitNoteLedger } from "@/types/chitNote"
import type { ExcelImportConfig } from "@/types/modal"
import {
    type AccountingChitNoteType,
    cloneChitNote,
    cloneChitNoteDetail,
    createDefaultChitNote,
    formatDateToYmd,
    formatYmdForDisplay,
    getChitNoteTypeLabel,
    mapChitNoteToApiPayload,
    normalizeChitNoteRows,
} from "./chitNoteUtils"
import ChitNoteColumns from "./components/ChitNoteColumns"
import ChitNoteDetailColumns from "./components/ChitNoteDetailColumns"
import ChitNoteEditorPopup from "./components/ChitNoteEditorPopup"

interface BankNoteManagementPageProps {
    ledger: ChitNoteLedger
    noteType: AccountingChitNoteType
    createImportConfig?: (translate: (key: string, fallback: string) => string) => ExcelImportConfig | null
}

export function BankNoteManagementPage({ ledger, noteType, createImportConfig }: BankNoteManagementPageProps) {
    const gridRef = useRef<dxDataGrid<ChitNote, number> | null>(null)
    const [loading, setLoading] = useState(true)
    const [popupLoading, setPopupLoading] = useState(false)
    const [popupVisible, setPopupVisible] = useState(false)
    const [isUpdate, setIsUpdate] = useState(false)
    const [isExcelModalOpen, setIsExcelModalOpen] = useState(false)
    const [detailSearchVisible, setDetailSearchVisible] = useState(false)
    const today = useMemo(() => {
        const d = new Date()
        d.setHours(0, 0, 0, 0)
        return d
    }, [])
    const [fromDate, setFromDate] = useState<Date | null>(today)
    const [toDate, setToDate] = useState<Date | null>(today)
    const [rows, setRows] = useState<ChitNote[]>([])
    const [selectedRow, setSelectedRow] = useState<ChitNote | null>(null)
    const [selectedRowDetails, setSelectedRowDetails] = useState<ChitNoteDetail[]>([])
    const [pageNumber, setPageNumber] = useState(1)
    const [pageSize, setPageSize] = useState(20)
    const [totalRecords, setTotalRecords] = useState(0)
    const [editingRow, setEditingRow] = useState<ChitNote>(() =>
        createDefaultChitNote(noteType, getCurrentCompanyCd(), getCurrentUserId()),
    )

    const { translate } = useContext(LanguageContext) as {
        translate?: (key: string, fallback?: string) => string
    }

    const t = useCallback(
        (key: string, fallback: string) => (translate ? translate(key, fallback) : fallback),
        [translate],
    )

    const title = useMemo(() => getChitNoteTypeLabel(noteType, t), [noteType, t])
    const importConfig = useMemo(() => createImportConfig?.(t) ?? null, [createImportConfig, t])
    const excelEnabled = importConfig !== null
    const totalPages = useMemo(
        () => Math.max(1, Math.ceil(totalRecords / Math.max(pageSize, 1))),
        [pageSize, totalRecords],
    )
    const startIndex = totalRecords === 0 ? 0 : (pageNumber - 1) * pageSize
    const endIndex = totalRecords === 0 ? 0 : startIndex + rows.length

    const loadData = useCallback(
        async function loadData(fromParam: Date | null, toParam: Date | null, targetPage = pageNumber, targetPageSize = pageSize) {
            setLoading(true)

            try {
                const fromYmd = formatDateToYmd(fromParam)
                const toYmd = formatDateToYmd(toParam)

                if (fromYmd && toYmd && fromYmd > toYmd) {
                    notify(t("INVALID_DATE_RANGE", "From date must be earlier than or equal to to date"), "warning", 3000)
                    setRows([])
                    gridRef.current?.clearSelection()
                    setSelectedRow(null)
                    setSelectedRowDetails([])
                    setTotalRecords(0)
                    setPageNumber(1)
                    return
                }

                const response = await getChitNotes(ledger, noteType, {
                    fromYmd,
                    toYmd,
                    pageNumber: targetPage,
                    pageSize: targetPageSize,
                    includeDetails: true,
                })
                const data = normalizeChitNoteRows(response.data || [], noteType)

                if (response.totalRecords > 0 && targetPage > response.totalPages) {
                    await loadData(fromParam, toParam, response.totalPages, targetPageSize)
                    return
                }

                setRows(data)
                setTotalRecords(response.totalRecords)
                setPageNumber(response.pageNumber)
                setPageSize(response.pageSize)
                gridRef.current?.clearSelection()
                const nextSelectedRow = data.length > 0 ? data[0] : null
                setSelectedRow(nextSelectedRow)
                setSelectedRowDetails(nextSelectedRow ? nextSelectedRow.DETAILS.map((item) => cloneChitNoteDetail(item)) : [])
            } catch (error) {
                console.error("Failed to load chit notes", error)
                notify(t("Load failed", "Load failed"), "error", 4000)
            } finally {
                setLoading(false)
            }
        },
        [ledger, noteType, pageNumber, pageSize, t],
    )

    useEffect(() => {
        void loadData(fromDate, toDate, 1, 20)
    }, [])

    const openCreatePopup = useCallback(() => {
        setIsUpdate(false)
        setEditingRow(createDefaultChitNote(noteType, getCurrentCompanyCd(), getCurrentUserId()))
        setPopupVisible(true)
    }, [noteType])

    const openEditPopup = useCallback((target?: ChitNote | null) => {
        const row = target ?? selectedRow
        if (!row?.CHIT_ID) {
            notify(t("Select a row first", "Select a row first"), "warning", 2500)
            return
        }

        setIsUpdate(true)
        setEditingRow(cloneChitNote(row))
        setPopupVisible(true)
    }, [selectedRow, t])

    const handleSave = useCallback(
        async (record: ChitNote) => {
            setPopupLoading(true)

            try {
                const payload = mapChitNoteToApiPayload(record)
                if (isUpdate) {
                    await updateChitNote(ledger, payload, noteType)
                    notify(t("MSG_EDIT_SUCCESS", "Updated successfully"), "success", 3000)
                } else {
                    await createChitNote(ledger, payload, noteType)
                    notify(t("MSG_INSERT_SUCCESS", "Created successfully"), "success", 3000)
                }

                setPopupVisible(false)
                await loadData(fromDate, toDate, pageNumber, pageSize)
            } catch (error) {
                console.error("Save chit note error", error)
                notify(t("Save failed", "Save failed"), "error", 4000)
            } finally {
                setPopupLoading(false)
            }
        },
        [fromDate, isUpdate, ledger, loadData, noteType, pageNumber, pageSize, t, toDate],
    )

    const handleDelete = useCallback(async () => {
        const selectedKeys = (gridRef.current?.getSelectedRowKeys() || []) as Array<string | number>
        const ids = selectedKeys
            .map((key) => Number(key))
            .filter((value) => Number.isFinite(value) && value > 0)

        if (!ids.length) {
            notify(t("No rows selected", "No rows selected"), "warning", 2500)
            return
        }

        const confirmText = t(
            "MSG_CONFIRM_DELETE_RECORD",
            "Are you sure you want to delete {0} record?",
        ).replace("{0}", String(ids.length))
        const confirmed = await confirm(confirmText, t("MSG_CONFIRM_DELETE", "Confirm delete"))
        if (!confirmed) {
            return
        }

        setLoading(true)

        try {
            await Promise.all(ids.map((id) => deleteChitNote(ledger, id, noteType)))
            notify(t("DELETE_SUCCESS", "Deleted successfully"), "success", 3000)
            await loadData(fromDate, toDate, pageNumber, pageSize)
        } catch (error) {
            console.error("Delete chit note error", error)
            notify(t("Delete failed", "Delete failed"), "error", 4000)
            setLoading(false)
        }
    }, [fromDate, ledger, loadData, noteType, pageNumber, pageSize, t, toDate])

    const handleSelectionChanged = useCallback((event: SelectionChangedEvent<ChitNote, number>) => {
        const nextRow = Array.isArray(event.selectedRowsData) && event.selectedRowsData.length > 0
            ? event.selectedRowsData[0]
            : null
        setSelectedRow(nextRow ?? null)
        setSelectedRowDetails(nextRow ? nextRow.DETAILS.map((item) => cloneChitNoteDetail(item)) : [])
    }, [])

    const handleRowDblClick = useCallback(
        (event: RowDblClickEvent<ChitNote, number>) => {
            void openEditPopup(event.data ?? null)
        },
        [openEditPopup],
    )

    const handleGridInitialized = useCallback((event: InitializedEvent<ChitNote, number>) => {
        gridRef.current = event.component ?? null
    }, [])

    const handleSearch = useCallback(() => {
        const grid = gridRef.current
        if (!grid) {
            setDetailSearchVisible((prev) => !prev)
            return
        }

        try {
            const filterCurrent = grid.option("filterRow.visible") as boolean | undefined
            const searchCurrent = grid.option("searchPanel.visible") as boolean | undefined
            const panelCurrent = grid.option("filterPanel.visible") as boolean | undefined

            grid.option("filterRow.visible", !filterCurrent)
            grid.option("searchPanel.visible", !searchCurrent)
            grid.option("filterPanel.visible", !(panelCurrent ?? false))
        } catch { }

        setDetailSearchVisible((prev) => !prev)
    }, [])

    const handleRangeSearch = useCallback(() => {
        void loadData(fromDate, toDate, 1, pageSize)
    }, [fromDate, loadData, pageSize, toDate])

    const handleRefresh = useCallback(() => {
        void loadData(fromDate, toDate, pageNumber, pageSize)
    }, [fromDate, loadData, pageNumber, pageSize, toDate])

    const handlePageChange = useCallback((nextPage: number) => {
        void loadData(fromDate, toDate, nextPage, pageSize)
    }, [fromDate, loadData, pageSize, toDate])

    const handlePageSizeChange = useCallback((nextPageSize: number) => {
        void loadData(fromDate, toDate, 1, nextPageSize)
    }, [fromDate, loadData, toDate])

    const handleExportExcel = useCallback(async () => {
        try {
            const selectedKeys = (gridRef.current?.getSelectedRowKeys() || []) as Array<string | number>
            const selectedChitId = selectedKeys.length > 0 ? Number(selectedKeys[0]) : null
            const blob = await exportChitNoteExcel(ledger, noteType, {
                chitId: Number.isFinite(selectedChitId) && (selectedChitId ?? 0) > 0 ? selectedChitId : null,
                fromYmd: formatDateToYmd(fromDate),
                toYmd: formatDateToYmd(toDate),
            })
            const url = URL.createObjectURL(blob)
            const anchor = document.createElement("a")
            const fileLabel = title.trim().replace(/\s+/g, "_").toLowerCase()

            anchor.href = url
            anchor.download = `${fileLabel}_${new Date().toISOString().replace(/[:.-]/g, "")}.xlsx`
            document.body.appendChild(anchor)
            anchor.click()
            anchor.remove()
            URL.revokeObjectURL(url)
        } catch (error) {
            console.error("Export chit note error", error)
            notify(t("EXPORT_FAILED", "Export failed"), "error", 4000)
        }
    }, [fromDate, ledger, noteType, t, title, toDate])

    const handleImport = useCallback(
        async (_rows: Array<Record<string, unknown>>, _method: "add" | "update" | "overwrite", file?: File) => {
            if (!file) {
                notify(t("VAL_SELECT_EXCEL_FILE", "Please select an Excel file"), "warning", 3000)
                return
            }

            try {
                await importChitNoteExcel(ledger, noteType, file)
                await loadData(fromDate, toDate, pageNumber, pageSize)
            } catch (error) {
                console.error("Import chit note error", error)
                notify(t("IMPORT_FAILED", "Import failed"), "error", 4000)
            }
        },
        [fromDate, ledger, loadData, noteType, pageNumber, pageSize, t, toDate],
    )

    return (
        <DxPage>
            <GridToolbar
                title={title}
                gridRef={gridRef}
                onAdd={openCreatePopup}
                onRefresh={handleRefresh}
                onSearch={handleSearch}
                onRangeSearch={handleRangeSearch}
                fromDate={fromDate}
                toDate={toDate}
                onFromDateChange={setFromDate}
                onToDateChange={setToDate}
                showDateRange={true}
                onDelete={handleDelete}
                onImport={excelEnabled ? () => setIsExcelModalOpen(true) : undefined}
                showExportPdf={false}
                onExportXlsx={excelEnabled ? handleExportExcel : undefined}
                showImport={excelEnabled}
                showExportXlsx={excelEnabled}
                customItems={[
                    {
                        key: "edit",
                        icon: "edit",
                        text: t("lblEdit", "Edit"),
                        hint: t("lblEdit", "Edit"),
                        stylingMode: "text",
                        disabled: !selectedRow?.CHIT_ID,
                        onClick: () => {
                            void openEditPopup()
                        },
                    },
                ]}
            />

            {excelEnabled && importConfig ? (
                <ExcelImportModal
                    isOpen={isExcelModalOpen}
                    onClose={() => setIsExcelModalOpen(false)}
                    onImport={handleImport}
                    existingData={rows}
                    config={importConfig}
                    serverImport={true}
                    hideUpdateOverwrite={true}
                />
            ) : null}

            <div className="flex flex-col gap-4">
                <div className="relative h-[460px] min-h-[320px] w-full lg:h-[520px]">
                    <PageGrid<ChitNote>
                        dataSource={rows}
                        keyExpr="CHIT_ID"
                        pagingEnabled={false}
                        showPager={false}
                        copyExcludeFields={[
                            "CHIT_ID",
                            "COMPANY_CD",
                            "CHIT_TYPE",
                            "USERID",
                            "DETAIL_COUNT",
                            "DETAILS",
                            "CREATE_BY",
                            "CREATE_DT",
                            "UPDATE_BY",
                            "UPDATE_DT",
                        ]}
                        onInitialized={handleGridInitialized}
                        onSelectionChanged={handleSelectionChanged}
                        onRowDblClick={handleRowDblClick}
                    >
                        <ChitNoteColumns />
                    </PageGrid>

                    <LoadPanel
                        visible={loading}
                        showIndicator={true}
                        showPane={true}
                        shading={true}
                        shadingColor="rgba(0, 0, 0, 0.15)"
                    />
                </div>

                <Pagination
                    currentPage={pageNumber}
                    totalPages={totalPages}
                    totalItems={totalRecords}
                    itemsPerPage={pageSize}
                    onPageChange={handlePageChange}
                    onItemsPerPageChange={handlePageSizeChange}
                    startIndex={startIndex}
                    endIndex={endIndex}
                />

                <div className="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                    <div className="mb-4 flex flex-col gap-3 border-b border-gray-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
                        <div>
                            <div className="text-sm font-semibold text-gray-800">
                                {t("DETAIL_INFO", "Detail Information")}
                            </div>
                            <div className="text-xs text-gray-500">
                                {selectedRow?.CHIT_ID
                                    ? `${selectedRow.CHIT_CD || "-"} · ${selectedRow.CHIT_NO || t("NO_DOCUMENT_NO", "No document no")}`
                                    : t("Select a row to view detail", "Select a row to view detail")}
                            </div>
                        </div>

                        {selectedRow?.CHIT_ID ? (
                            <div className="flex flex-wrap gap-2 text-xs text-gray-600">
                                <span className="rounded-full bg-gray-100 px-3 py-1">
                                    {t("CHIT_YMD", "Note Date")}: {formatYmdForDisplay(selectedRow.CHIT_YMD) || "-"}
                                </span>
                                <span className="rounded-full bg-gray-100 px-3 py-1">
                                    {t("AMOUNT", "Amount")}: {selectedRow.AMOUNT ?? 0}
                                </span>
                                <span className="rounded-full bg-gray-100 px-3 py-1">
                                    {t("DETAIL_COUNT", "Lines")}: {selectedRowDetails.length}
                                </span>
                            </div>
                        ) : null}
                    </div>
                    <div className="relative">
                        <DetailGrid<ChitNoteDetail>
                            dataSource={selectedRowDetails}
                            keyExpr="ROW_KEY"
                            height={320}
                            noDataText={
                                selectedRow?.CHIT_ID
                                    ? t("NO_DETAIL_DATA", "No detail data")
                                    : t("Select a row to view detail", "Select a row to view detail")
                            }
                            filterRowVisible={detailSearchVisible}
                            searchPanelVisible={detailSearchVisible}
                        >
                            <ChitNoteDetailColumns />
                        </DetailGrid>
                    </div>
                </div>
            </div>

            <ChitNoteEditorPopup
                visible={popupVisible}
                value={editingRow}
                noteType={noteType}
                isUpdate={isUpdate}
                loading={popupLoading}
                onClose={() => {
                    if (!popupLoading) {
                        setPopupVisible(false)
                    }
                }}
                onSave={handleSave}
            />
        </DxPage>
    )
}

export default BankNoteManagementPage
