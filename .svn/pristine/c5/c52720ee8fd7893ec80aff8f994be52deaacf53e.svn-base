import type { AxiosResponse } from "axios"

import axios from "./axiosClient"
import API_BASE_URL from "../config/apiConfig"
import type { ChitNoteApi, ChitNoteLedger, ChitNoteType } from "@/types/chitNote"
import type { PagedResult } from "@/types/paging"

type ApiEnvelope<T> = {
  Data?: T
  Message?: string
  Success?: boolean
  data?: T
  message?: string
  success?: boolean
}

type GetChitNotesParams = {
  fromYmd?: string | null
  toYmd?: string | null
  pageNumber?: number
  pageSize?: number
  includeDetails?: boolean
}

type ExportChitNotesParams = GetChitNotesParams & {
  chitId?: number | null
}

function unwrapPayload<T>(response: AxiosResponse<ApiEnvelope<T> | T>): ApiEnvelope<T> | T {
  return response.data
}

function normalizeResponse<T>(
  response: AxiosResponse<ApiEnvelope<T> | T>,
): { data: T; message?: string; success?: boolean } {
  const payload = unwrapPayload(response)
  const envelope = (payload as ApiEnvelope<T>).Data ?? (payload as ApiEnvelope<T>).data

  return {
    data: (envelope ?? payload) as T,
    message: (payload as ApiEnvelope<T>).Message ?? (payload as ApiEnvelope<T>).message ?? "",
    success: (payload as ApiEnvelope<T>).Success ?? (payload as ApiEnvelope<T>).success ?? true,
  }
}

function normalizePagedResponse<T>(
  response: AxiosResponse<ApiEnvelope<T[]> | T[]>,
  fallbackPageNumber = 1,
  fallbackPageSize = 20,
): PagedResult<T> {
  const payload = unwrapPayload(response) as ApiEnvelope<T[]> & {
    PageNumber?: number
    PageSize?: number
    TotalRecords?: number
    TotalPages?: number
    HasPrevious?: boolean
    HasNext?: boolean
  }
  const envelope = payload.Data ?? payload.data
  const data = Array.isArray(envelope ?? payload) ? ((envelope ?? payload) as T[]) : []
  const pageSize = payload.PageSize ?? fallbackPageSize
  const totalRecords = payload.TotalRecords ?? data.length
  const totalPages = payload.TotalPages ?? Math.max(1, Math.ceil(totalRecords / Math.max(pageSize, 1)))
  const pageNumber = payload.PageNumber ?? fallbackPageNumber

  return {
    data,
    pageNumber,
    pageSize,
    totalRecords,
    totalPages,
    hasPrevious: payload.HasPrevious ?? pageNumber > 1,
    hasNext: payload.HasNext ?? pageNumber < totalPages,
    message: payload.Message ?? payload.message ?? "",
    success: payload.Success ?? payload.success ?? true,
  }
}

function getBaseUrl(ledger: ChitNoteLedger, noteType?: ChitNoteType): string {
  if (ledger === "AP" && noteType === "PO") {
    return `${API_BASE_URL}/PurchaseVoucherAp`
  }

  return `${API_BASE_URL}/${ledger === "AP" ? "ChitNoteAp" : "ChitNoteAr"}`
}

export async function getChitNotes(
  ledger: ChitNoteLedger,
  noteType?: ChitNoteType,
  filters: GetChitNotesParams = {},
): Promise<PagedResult<ChitNoteApi>> {
  const params: Record<string, string | number | boolean> = {}

  if (noteType) {
    params.CHIT_TYPE = noteType
  }

  if (filters.fromYmd) {
    params.FROM_YMD = filters.fromYmd
  }

  if (filters.toYmd) {
    params.TO_YMD = filters.toYmd
  }

  if (filters.pageNumber && filters.pageNumber > 0) {
    params.PAGE_NUMBER = filters.pageNumber
  }

  if (filters.pageSize && filters.pageSize > 0) {
    params.PAGE_SIZE = filters.pageSize
  }

  if (filters.includeDetails) {
    params.INCLUDE_DETAILS = true
  }

  const response = await axios.get<ApiEnvelope<ChitNoteApi[]>>(`${getBaseUrl(ledger, noteType)}/Get`, {
    params: Object.keys(params).length > 0 ? params : undefined,
  })

  return normalizePagedResponse<ChitNoteApi>(
    response,
    filters.pageNumber ?? 1,
    filters.pageSize ?? 20,
  )
}

export async function exportChitNoteExcel(
  ledger: ChitNoteLedger,
  noteType?: ChitNoteType,
  filters: ExportChitNotesParams = {},
): Promise<Blob> {
  const params: Record<string, string | number> = {}

  if (filters.chitId && filters.chitId > 0) {
    params.CHIT_ID = filters.chitId
  }

  if (filters.fromYmd) {
    params.FROM_YMD = filters.fromYmd
  }

  if (filters.toYmd) {
    params.TO_YMD = filters.toYmd
  }

  const response = await axios.get(`${getBaseUrl(ledger, noteType)}/ExportExcel`, {
    params: Object.keys(params).length > 0 ? params : undefined,
    responseType: "blob",
  })

  return response.data
}

export async function importChitNoteExcel(
  ledger: ChitNoteLedger,
  noteType: ChitNoteType,
  file: File,
): Promise<unknown> {
  const formData = new FormData()
  formData.append("file", file)

  const response = await axios.post(`${getBaseUrl(ledger, noteType)}/ImportExcel`, formData)
  return response.data
}

export async function createChitNote(
  ledger: ChitNoteLedger,
  payload: Partial<ChitNoteApi>,
  noteType?: ChitNoteType,
): Promise<{ data: ChitNoteApi; message?: string }> {
  const response = await axios.post<ApiEnvelope<ChitNoteApi> | ChitNoteApi>(`${getBaseUrl(ledger, noteType)}/Create`, payload)
  const { data, message } = normalizeResponse<ChitNoteApi>(response)

  return { data, message }
}

export async function updateChitNote(
  ledger: ChitNoteLedger,
  payload: Partial<ChitNoteApi>,
  noteType?: ChitNoteType,
): Promise<{ data: ChitNoteApi; message?: string }> {
  const response = await axios.put<ApiEnvelope<ChitNoteApi> | ChitNoteApi>(`${getBaseUrl(ledger, noteType)}/Update`, payload)
  const { data, message } = normalizeResponse<ChitNoteApi>(response)

  return { data, message }
}

export async function deleteChitNote(
  ledger: ChitNoteLedger,
  chitId: number,
  noteType?: ChitNoteType,
): Promise<{ success: boolean; message?: string }> {
  const response = await axios.delete<ApiEnvelope<number>>(`${getBaseUrl(ledger, noteType)}/Delete`, {
    params: { CHIT_ID: chitId },
  })
  const { success, message } = normalizeResponse<number>(response)

  return { success: success ?? true, message }
}
