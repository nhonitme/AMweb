.data-tree-list-container {
  width: 100%;
  height: 100%;
  min-height: 0;
  min-width: 0;

  box-shadow: 0 4px 4px rgba(0, 0, 0, 0.1);
  border-radius: 8px;

  .dx-treelist {

    .dx-treelist-headers .dx-row > td {
      background-color: #f0f4f9; /* slightly darker header */
      color: rgba(0, 0, 0, 0.85);
      border-bottom: 2px solid rgba(0, 0, 0, 0.08);
      font-weight: 600;
    }

    .dx-treelist-headers .dx-row > td,
    .dx-treelist-rowsview .dx-row > td {
      border-right: 1px dashed rgba(0, 0, 0, 0.12);
    }

  }
}
