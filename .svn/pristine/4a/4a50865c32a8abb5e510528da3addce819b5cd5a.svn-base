interface SidebarProps {
  menuTree: MenuTreeNode[];
  activeMenu: string;
  onMenuSelect: (menuItem: MenuTreeNode) => void;
  isCollapsed: boolean;
  isMobile?: boolean;
  loading: boolean;
}

const iconMap: { [key: string]: React.ReactNode } = {
  BarChart3: <BarChart3 size={16} />,
  bar_chart_3: <BarChart3 size={16} />,
  bar_chart: <BarChart3 size={16} />,
  Database: <Database size={16} />,
  database: <Database size={16} />,
  Building2: <Building2 size={16} />,
  building_2: <Building2 size={16} />,
  building: <Building2 size={16} />,
  Users: <Users size={16} />,
  users: <Users size={16} />,
  Target: <Target size={16} />,
  target: <Target size={16} />,
  UserCheck: <UserCheck size={16} />,
  user_check: <UserCheck size={16} />,
  User: <User size={16} />,
  user: <User size={16} />,
  Banknote: <Banknote size={16} />,
  banknote: <Banknote size={16} />,
  Key: <Key size={16} />,
  key: <Key size={16} />,
  CreditCard: <CreditCard size={16} />,
  credit_card: <CreditCard size={16} />,
  Warehouse: <Warehouse size={16} />,
  warehouse: <Warehouse size={16} />,
  Package: <Package size={16} />,
  package: <Package size={16} />,
  Layers: <Layers size={16} />,
  layers: <Layers size={16} />,
  Archive: <Archive size={16} />,
  archive: <Archive size={16} />,
  Grid: <Grid size={16} />,
  grid: <Grid size={16} />,
  Ruler: <Ruler size={16} />,
  ruler: <Ruler size={16} />,
  Settings: <Settings size={16} />,
  settings: <Settings size={16} />,
  FileText: <FileText size={16} />,
  file_text: <FileText size={16} />,
  file_invoice: <FileText size={16} />,
  BookOpen: <BookOpen size={16} />,
  book_open: <BookOpen size={16} />,
  book: <Book size={16} />,
  Calculator: <Calculator size={16} />,
  calculator: <Calculator size={16} />,
  ShoppingCart: <ShoppingCart size={16} />,
  shopping_cart: <ShoppingCart size={16} />,
  TrendingUp: <TrendingUp size={16} />,
  trending_up: <TrendingUp size={16} />,
  Receipt: <Receipt size={16} />,
  receipt: <Receipt size={16} />,
  Home: <Home size={16} />,
  home: <Home size={16} />,
  File: <File size={16} />,
  file: <File size={16} />,
  Wallet: <Wallet size={16} />,
  wallet: <Wallet size={16} />,
  Menu: <MenuIcon size={16} />,
  menu: <MenuIcon size={16} />,
  dashboard: <BarChart3 size={16} />,
  repeat: <ChevronDown size={16} style={{ transform: 'rotate(90deg)' }} />,
  download: <Download size={16} />,
  upload: <Upload size={16} />,
  shuffle: <Shuffle size={16} />,
  boxes: <Package size={16} />,
  box: <Box size={16} />,
  truck: <Truck size={16} />,
  table: <Table size={16} />,
  list: <List size={16} />,
  shield: <Shield size={16} />,
  percent: <Percent size={16} />,
};

const getIconComponent = (iconName: string): React.ReactNode => {
  return iconMap[iconName] || iconMap[iconName.toLowerCase()] || <MenuIcon size={16} />;
};

function findPathToNode(
  nodeList: MenuTreeNode[],
  targetId: string,
  path: string[] = []
): string[] | null {
  for (const node of nodeList) {
    const currentPath = [...path, node.id];
    if (node.id === targetId) return currentPath;
    if (node.children && node.children.length > 0) {
      const found = findPathToNode(node.children, targetId, currentPath);
      if (found) return found;
    }
  }
  return null;
}

function findAllPathsToMatchedNodes(
  nodeList: MenuTreeNode[],
  term: string,
  path: string[] = []
): string[][] {
  let result: string[][] = [];
  for (const node of nodeList) {
    const currentPath = [...path, node.id];
    const nodeMatch = node.name.toLowerCase().includes(term.toLowerCase());
    let childMatched = false;
    if (node.children && node.children.length > 0) {
      const childPaths = findAllPathsToMatchedNodes(node.children, term, currentPath);
      if (childPaths.length > 0) {
        result = result.concat(childPaths);
        childMatched = true;
      }
    }
    if (nodeMatch || childMatched) {
      result.push(currentPath);
    }
  }
  return result;
}

function collectNodeIds(node: MenuTreeNode): string[] {
  const ids: string[] = [node.id];
  if (node.children && node.children.length > 0) {
    node.children.forEach(child => {
      ids.push(...collectNodeIds(child));
    });
  }
  return ids;
}

function SidebarMenuNode({
  node,
  level = 0,
  expandedIds,
  onMenuSelect,
  location,
  setExpandedIds,
  isSearching = false,
  searchTerm = '',
  siblingNodes = [],
}: {
  node: MenuTreeNode;
  level?: number;
  expandedIds: string[];
  onMenuSelect: (menuItem: MenuTreeNode) => void;
  location: ReturnType<typeof useLocation>;
  setExpandedIds: React.Dispatch<React.SetStateAction<string[]>>;
  isSearching?: boolean;
  searchTerm?: string;
  siblingNodes?: MenuTreeNode[];
}) {
  const { translate = (s: string) => s } = useContext(LanguageContext) as { translate?: (k: string, f?: string) => string };
  const hasChildren = !!node.children && node.children.length > 0;
  const isExpanded = isSearching ? true : expandedIds.includes(node.id);

  const isActive = (() => {
    if (expandedIds[expandedIds.length - 1] === node.id) return true;
    if (level === 1 && hasChildren) {
      if (expandedIds.includes(node.id)) return true;
      return node.children?.some(sub => expandedIds.includes(sub.id));
    }
    if (level === 0 && hasChildren) {
      if (expandedIds.includes(node.id)) return true;
      return node.children?.some(sub => expandedIds.includes(sub.id) || (sub.children && sub.children.some(third => expandedIds.includes(third.id))));
    }
    return false;
  })();

  const closeSiblings = (prev: string[]) => {
    if (!siblingNodes || siblingNodes.length === 0) return prev;
    const idsToClose = siblingNodes
      .filter((sibling) => sibling.id !== node.id)
      .flatMap(collectNodeIds);
    return prev.filter((id) => !idsToClose.includes(id));
  };

  const toggleExpanded = (expand: boolean) => {
    setExpandedIds((prev) => {
      let next = prev;
      if (expand) {
        next = closeSiblings(next);
        if (!next.includes(node.id)) {
          next = [...next, node.id];
        }
      } else {
        const idsToCollapse = collectNodeIds(node);
        next = next.filter((id) => !idsToCollapse.includes(id));
      }
      return next;
    });
  };

  const handleToggle = (e: React.MouseEvent) => {
    e.stopPropagation();
    toggleExpanded(!isExpanded);
  };

  const handleClick = () => {
    if (node.routePath && !node.isDisabled) {
      onMenuSelect(node);
    } else if (hasChildren) {
      toggleExpanded(!isExpanded);
    }
  };

  const highlightText = (text: string, term: string) => {
    if (!term) return text;
    const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    const parts = text.split(regex);
    return parts.map((part, i) =>
      regex.test(part)
        ? <span key={i} className="bg-yellow-200 text-red-700 font-bold">{part}</span>
        : part
    );
  };

  return (
    <div className="relative">
      {hasChildren && isExpanded && (
        <div
          className="absolute top-7 bottom-0 left-2 border-l border-dashed border-gray-400 z-0"
          style={{ left: `${level * 24 + 8}px` }}
        />
      )}
      <div className="relative flex items-center" style={{ paddingLeft: `${level * 24}px` }}>
        {level > 0 && (
          <span
            className="absolute left-0 top-1/2 -translate-y-1/2 border-t border-dashed border-gray-400 w-4 z-10"
            style={{
              left: `${(level - 1) * 24 + 8}px`
            }}
          />
        )}
        <button
          onClick={handleClick}
          disabled={node.isDisabled}
          className={(() => {
            const classes: string[] = [
              'relative z-10 w-full flex items-center justify-between px-3 group',
              level > 0 ? 'py-1.5' : 'py-2.5',
              'text-left rounded-lg transition-all duration-200',
            ];
            if (node.isDisabled) classes.push('opacity-50 cursor-not-allowed');

            if (level === 0) {
              classes.push('text-black', 'font-bold');
            } else {
              classes.push('text-gray-600');
            }

            if (isActive && !isSearching) {
              classes.push('font-bold');
            }

            classes.push('hover:bg-red-600 hover:text-white');

            return classes.join(' ');
          })()}
        >
          <div className="flex items-center space-x-3">
            {level === 0 && node.icon && (
              <span className={`flex-shrink-0 ${level === 0 ? 'text-black' : 'text-gray-400'} group-hover:text-white`}>
                {getIconComponent(node.icon)}
              </span>
            )}
            <span className={`text-sm ${level > 0 ? 'font-normal' : 'font-medium'}${level > 0 && isActive && !isSearching ? ' text-red-700 font-bold' : ''}`}>
              <>{highlightText(translate(node.name), searchTerm)}</>
            </span>
          </div>
        </button>
        {hasChildren && (
          <button
            onClick={handleToggle}
            className={`absolute right-3 top-1/2 transform -translate-y-1/2 p-1 rounded transition-all duration-200 z-20 ${
              'text-gray-400 hover:text-red-400 hover:bg-gray-100'
            }`}
          >
            <ChevronDown 
              size={14} 
              className={`transition-transform duration-200 ${isExpanded ? 'rotate-180' : ''}`}
            />
          </button>
        )}
      </div>
      {hasChildren && isExpanded && (
        <div className="relative">
          {node.children!.map((child) => (
            <SidebarMenuNode
              key={child.id}
              node={child}
              level={level + 1}
              expandedIds={expandedIds}
              onMenuSelect={onMenuSelect}
              location={location}
              setExpandedIds={setExpandedIds}
              isSearching={isSearching}
              siblingNodes={node.children}
            />
          ))}
        </div>
      )}
    </div>
  );
}

export default function Sidebar({
  menuTree,
  activeMenu,
  onMenuSelect,
  isCollapsed,
  isMobile = false,
  loading,
}: SidebarProps) {
  const [expandedIds, setExpandedIds] = useState<string[]>([]);
  const [searchTerm, setSearchTerm] = useState('');
  const [isSidebarHovered, setSidebarHovered] = useState(false);
  const [originalMenuState, setOriginalMenuState] = useState<{ expandedIds: string[]; activeMenu: string | null } | null>(null);
  const location = useLocation();
  const { translate = (s: string) => s } = useContext(LanguageContext) as { translate?: (k: string, f?: string) => string };
  const searchInputRef = React.useRef<HTMLInputElement>(null);



  useEffect(() => {
    if (menuTree && menuTree.length && expandedIds.length === 0) {
      const ids: string[] = menuTree.map(l1 => l1.id);
      setExpandedIds(ids);
    }
  }, [menuTree]);

  React.useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        searchInputRef.current?.focus();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  const handleMenuSelect = (menuItem: MenuTreeNode) => {
    const path = findPathToNode(menuTree, menuItem.id);
    if (path) {
      setExpandedIds(path);
      onMenuSelect(menuItem);
      if (searchTerm && !originalMenuState) {
        setOriginalMenuState({ expandedIds, activeMenu });
      }
    }
  };

  const filterMenuItems = (nodes: MenuTreeNode[]): MenuTreeNode[] => {
    if (!searchTerm) return nodes;

    const allPaths = findAllPathsToMatchedNodes(nodes, searchTerm, []);
    const idsToShow = new Set<string>();
    allPaths.forEach(path => path.forEach(id => idsToShow.add(id)));

    const filterNodes = (items: MenuTreeNode[]): MenuTreeNode[] => {
      return items
        .filter(item => idsToShow.has(item.id))
        .map(item => ({
          ...item,
          children: item.children ? filterNodes(item.children) : undefined,
        }));
    };

    return filterNodes(nodes);
  };

  const filteredMenuTree = filterMenuItems(menuTree);

  useEffect(() => {
    if (searchTerm) {
      if (!originalMenuState) {
        setOriginalMenuState({ expandedIds, activeMenu });
      }
      const allMatchedIds: string[] = [];
      const paths = findAllPathsToMatchedNodes(menuTree, searchTerm, []);
      paths.forEach(path => {
        path.forEach(nodeId => {
          if (!allMatchedIds.includes(nodeId)) {
            allMatchedIds.push(nodeId);
          }
        });
      });
      setExpandedIds(allMatchedIds);
    } else {
      if (originalMenuState) {
        setExpandedIds(originalMenuState.expandedIds);
        setOriginalMenuState(null);
      }
    }
  }, [searchTerm, activeMenu, expandedIds, menuTree, originalMenuState]);

  useEffect(() => {
    if (!searchTerm && activeMenu) {
      const path = findPathToNode(menuTree, activeMenu);
      if (path && path.length) {
        setExpandedIds(path);
      }
    }
  }, [activeMenu, searchTerm, menuTree]);



  if (loading) {
    return (
      <div className="flex items-center justify-center h-full bg-gray-800 text-white">
        Loading...
      </div>
    );
  }

  if (isCollapsed && !isMobile) {
    return (
      <>
        <div
          className="bg-red-50 border-r border-red-200 w-16 h-screen flex flex-col z-20"
          onMouseEnter={() => setSidebarHovered(true)}
          onMouseLeave={() => setSidebarHovered(false)}
          style={{ position: 'relative' }}
        >
          <div className="p-3 border-b border-gray-200 flex-shrink-0">
            <div className="w-10 h-10 bg-red-600 rounded-lg flex items-center justify-center">
              <span className="text-white font-bold text-sm">{translate('AM')}</span>
            </div>
          </div>
          <nav className="flex-1 overflow-y-auto p-2">
            <div className="space-y-1">
              {menuTree.map((item) => {
                const hasChildren = !!item.children && item.children.length > 0;
                const isActive = (() => {
                  if (activeMenu === item.id) return true;
                  if (hasChildren) {
                    if (item.children?.some(sub => sub.id === activeMenu)) return true;
                    return item.children?.some(sub => sub.children?.some(third => third.id === activeMenu));
                  }
                  return false;
                })();
                return (
                  <button
                    key={item.id}
                    onClick={() => onMenuSelect(item)}
                    disabled={item.isDisabled}
                    className={`w-full flex items-center justify-center p-3 rounded-lg transition-all duration-200 ${
                      isActive
                        ? 'bg-red-50 text-red-700'
                        : 'text-gray-700 hover:bg-gray-50'
                    } ${item.isDisabled ? 'opacity-50 cursor-not-allowed' : ''}`}
                    title={translate(item.name)}
                  >
                    <div className={`${isActive ? 'text-red-600' : 'text-gray-400'}`}>
                      {getIconComponent(item.icon)}
                    </div>
                  </button>
                );
              })}
            </div>
          </nav>
        </div>
        {isSidebarHovered && (
          <div
            className="fixed left-0 top-0 h-screen w-64 bg-red-50 border-r border-red-200 shadow-lg z-[99] flex flex-col"
            onMouseEnter={() => setSidebarHovered(true)}
            onMouseLeave={() => setSidebarHovered(false)}
            style={{ pointerEvents: 'auto' }}
          >
            <div className="p-4 border-b border-gray-200 flex-shrink-0">
              <div className="flex items-center space-x-3">
                <div className="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
                  <span className="text-white font-bold text-sm">{translate('AM')}</span>
                </div>
                <div>
                  <h1 className="text-lg font-bold text-gray-900">{translate('AMnote')}</h1>
                  <p className="text-xs text-gray-500">{translate('Phần mềm kế toán')}</p>
                </div>
              </div>
            </div>
            <div className="p-3 border-b border-gray-200 flex-shrink-0">
            <div className="relative menu-search-wrapper">
                <Search size={16} className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" />
                <TextBox
                  stylingMode="outlined"
                  value={searchTerm}
                  valueChangeEvent="keyup"
                  onValueChanged={(e) => setSearchTerm(e.value as string)}
                  placeholder={translate('Tìm kiếm menu...')}
                  inputAttr={{ className: 'text-sm menu-search-input' }}
                  className="w-full pl-9"
                  showClearButton
                />
              </div>
            </div>
            <nav className="flex-1 overflow-y-auto p-2">
              <div className="space-y-1">
                {filteredMenuTree.map((item) => (
                  <SidebarMenuNode
                    key={item.id}
                    node={item}
                    level={0}
                    expandedIds={expandedIds}
                    onMenuSelect={handleMenuSelect}
                    location={location}
                    setExpandedIds={setExpandedIds}
                    isSearching={!!searchTerm}
                    searchTerm={searchTerm}
                  />
                ))}
              </div>
            </nav>
            <div className="p-4 border-t border-gray-200 flex-shrink-0">
              <div className="flex items-center space-x-3">
                <div className="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center">
                  <span className="text-white text-sm font-medium">ML</span>
                </div>
                <div className="flex-1 min-w-0">
                  <div className="text-sm font-medium text-gray-900 truncate">{translate('Nguyễn Mỹ Liên')}</div>
                  <div className="text-xs text-gray-500 truncate">{translate('Kế toán trưởng')}</div>
                </div>
              </div>
            </div>
          </div>
        )}
      </>
    );
  }

  return (
    <Drawer
      opened={!isCollapsed || isMobile}
      revealMode="slide"
      shading={false}
      position="left"
      closeOnOutsideClick={false}
      className="bg-red-50 border-r border-red-200 h-screen"
    >
      <div
        className={`bg-red-50 border-r border-red-200 ${
          isMobile ? 'w-64' : 'w-64'
        } h-full flex flex-col`}
      >
      <div className="p-4 border-b border-gray-200 flex-shrink-0">
        <div className="flex items-center space-x-3">
          <div className="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center">
            <span className="text-white font-bold text-sm">AM</span>
          </div>
          <div>
            <h1 className="text-lg font-bold text-gray-900">AMnote</h1>
            <p className="text-xs text-gray-500">Phần mềm kế toán</p>
          </div>
        </div>
      </div>

      <div className="p-3 border-b border-gray-200 flex-shrink-0">
        <div className="relative menu-search-wrapper">
          <Search size={16} className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" />
          <TextBox
            stylingMode="outlined"
            value={searchTerm}
            valueChangeEvent="keyup"
            onValueChanged={(e) => setSearchTerm(e.value as string)}
            placeholder={translate('Tìm kiếm menu...')}
            inputAttr={{ className: 'text-sm menu-search-input' }}
            className="w-full pl-9"
            showClearButton
          />
        </div>
      </div>
      
      <nav className="flex-1 overflow-y-auto p-2">
        <div className="space-y-1">
          {filteredMenuTree.map((item) => (
            <SidebarMenuNode
              key={item.id}
              node={item}
              level={0}
              expandedIds={expandedIds}
              onMenuSelect={handleMenuSelect}
              location={location}
              setExpandedIds={setExpandedIds}
              isSearching={!!searchTerm}
              searchTerm={searchTerm}
            />
          ))}
        </div>
      </nav>
      <div className="p-4 border-t border-gray-200 flex-shrink-0">
        <div className="flex items-center space-x-3">
          <div className="w-8 h-8 bg-red-600 rounded-full flex items-center justify-center">
            <span className="text-white text-sm font-medium">ML</span>
          </div>
          <div className="flex-1 min-w-0">
            <div className="text-sm font-medium text-gray-900 truncate">{translate('Nguyễn Mỹ Liên')}</div>
            <div className="text-xs text-gray-500 truncate">{translate('Kế toán trưởng')}</div>
          </div>
        </div>
      </div>
    </div>
    </Drawer>
  );
}