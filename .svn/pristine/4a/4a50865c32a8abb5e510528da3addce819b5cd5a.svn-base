  Home, 
  File, 
  ChevronDown,
  Search,
  Wallet,
  Menu as MenuIcon,
  Download,
  Upload,
  Shuffle,
  Box,
  Truck,
  BookOpen as Book,
  Table,
  List,
  Shield,
  User,
