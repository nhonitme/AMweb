import { useMemo } from "react";
import { useSearchParams } from "react-router-dom";

import ReportViewerShell from "./ReportViewerShell";
import { buildConfiguredReportUrl, resolveReportCompanyCd } from "./reportViewerConfig";

export default function ProductReportViewer() {
  const [searchParams] = useSearchParams();

  const reportUrl = useMemo(() => {
    const companyCd = resolveReportCompanyCd(searchParams.get("companyCd"));
    return buildConfiguredReportUrl({
      companyCd,
      reportCode: "PRODUCT_INFO",
    });
  }, [searchParams]);

  return <ReportViewerShell reportUrl={reportUrl} />;
}
