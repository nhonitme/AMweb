// Overwrite/merge app-provided labels into messages
function mergeLabelsIntoMessages(labels: any[]) {
  messages.vi ||= {};
  messages.en ||= {};
  messages.zh ||= {};
  messages.ko ||= {};
  messages.ja ||= {};

  for (const lbl of labels || []) {
    const anyLbl = lbl as any;
    const key = String(anyLbl.KEY ?? anyLbl.key ?? '');
    if (!key) continue;

    // overwrite app-specific keys so updates show immediately
    messages.vi[key] = anyLbl.VIET ?? '';
    messages.en[key] = anyLbl.ENG ?? '';
    messages.zh[key] = anyLbl.CHN ?? '';
    messages.ko[key] = anyLbl.KOR ?? '';
    messages.ja[key] = anyLbl.JPN ?? '';
  }
}

const defaultCacheKey = 'appLabels_v1';

export function initMessagesFromCache(cacheKey = defaultCacheKey) {
  try {
    const raw = localStorage.getItem(cacheKey);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed && parsed._ts && Array.isArray(parsed.data)) {
        mergeLabelsIntoMessages(parsed.data);
      }
    }
  } catch (err) {
    // ignore cache errors
  }
}

export async function refreshLanguages(cacheKey = defaultCacheKey, timeoutMs = 5000) {
  try {
    const timeout = (ms: number) => new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms));
    const result = await Promise.race([getLanguages(), timeout(timeoutMs)]) as any;
    if (!Array.isArray(result)) return;

    // compare with cache
    let cached: any[] = [];
    try {
      const raw = localStorage.getItem(cacheKey);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && Array.isArray(parsed.data)) cached = parsed.data;
      }
    } catch {}

    const changed = JSON.stringify(result) !== JSON.stringify(cached);
    if (changed) {
      mergeLabelsIntoMessages(result);
      loadMessages(messages);
      // re-apply current locale to ensure UI picks up new strings
      locale(getCurrentLang());
      try {
        localStorage.setItem(cacheKey, JSON.stringify({ _ts: Date.now(), data: result }));
      } catch {}
    }
  } catch (err) {
    // background failures are non-fatal
    console.debug('refreshLanguages failed', err);
  }
}
