import axios from './axiosClient';
import API_BASE_URL from '../config/apiConfig';
import type { StoreInfo } from "@/types/store"

const BASE_URL = `${API_BASE_URL}/StoreInfo`;



// GET all (optionally filtered by storeCode)
export async function getStoreInfos(
  storeCode?: string
): Promise<{ data: StoreInfo[] }> {
  try {
    const resp = await axios.get(`${BASE_URL}`, {
      params: { STORE_CD: storeCode },
    });

    // log for debugging
    console.debug("getStoreInfos response status", resp.status);
    console.debug("getStoreInfos response data", resp.data);

    if (resp.status !== 200) {
      throw new Error(`Unexpected HTTP status ${resp.status}`);
    }

    // the controller may return several wrapper shapes. normalize to { data, labels }
    const payload = resp.data;
    if (!payload || typeof payload !== "object") {
      throw new Error("Invalid response format from getStoreInfos");
    }

    // possible shapes:
    // { data: [...], labels: {...} }
    // { Data: { data: [...], labels: {...} } }
    // { data: { data: [...], labels: {...} } }
    const inner = payload.Data ?? payload.data ?? payload;

    // If inner is the array itself, there are no labels
    if (Array.isArray(inner)) {
      return { data: inner as StoreInfo[]};
    }

    const list = inner.data ?? inner;

    if (!Array.isArray(list)) {
      throw new Error("Response did not contain an array of customer exts");
    }

    return { data: list as StoreInfo[]};
  } catch (err: any) {
    console.error("Error in getStoreInfos:", err);
    if (err.response) {
      console.error("Response data:", err.response.data);
      console.error("Response status:", err.response.status);
    }
    throw err; // rethrow so caller can handle
  }
}

// POST create
export async function createStoreInfo(
  payload: Partial<StoreInfo>
): Promise<any> {
  const resp = await axios.post(`${BASE_URL}`, payload);
  return resp.data;
}

// PUT update
export async function updateStoreInfo(
  payload: Partial<StoreInfo>
): Promise<any> {
  const resp = await axios.put(`${BASE_URL}`, payload);
  return resp.data;
}

// DELETE by STORE_CD
export async function deleteStoreInfo(
  storeId: string
): Promise<any> {
  const resp = await axios.delete(`${BASE_URL}`, {
    params: { STORE_ID: storeId },
  });
  return resp.data;
}

// Export to Excel (optionally filter by store ID)
export async function exportToExcel(
  storeID?: string,
  lang?: string
): Promise<Blob> {
  const params: any = {};
  if (storeID) params.STORE_ID = storeID;
  if (lang) params.lang = lang;
  const resp = await axios.get(`${BASE_URL}/ExportExcel`, {
    params,
    responseType: 'blob',
  });
  return resp.data;
}

export async function importFromExcel(
  file: File,
  lang?: string
): Promise<any> {
  const form = new FormData();
  form.append('file', file);
  const url = `${BASE_URL}/ImportExcel${lang ? `?lang=${encodeURIComponent(lang)}` : ''}`;
   try {
    // NOTE: do not manually set Content-Type when sending FormData so that
    // the browser/axios can append the correct boundary information.
    const resp = await axios.post(url, form);
    console.debug('importStoreInfoExcel response', resp.status, resp.data);
    return resp.data;
  } catch (err) {
    console.error('importStoreInfoExcel error', err);
    throw err;
  }
}

