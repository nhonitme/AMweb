import { useContext } from "react"
import { Column } from "devextreme-react/data-grid"

import { LanguageContext } from "@/lib/i18nLoader"

export function ChitNoteDetailColumns() {
  const { translate } = useContext(LanguageContext) as {
    translate?: (key: string, fallback?: string) => string
  }

  const t = (key: string, fallback: string) => (translate ? translate(key, fallback) : fallback)

  return (
    <>
      <Column dataField="SORT" caption={t("SORT", "Sort")} dataType="number" width={90} />
      <Column dataField="CHITDETAIL_CD" caption={t("CHITDETAIL_CD", "Line Code")} width={170} />
      <Column dataField="CHIT_YMD" caption={t("CHIT_YMD", "Posting Date")} dataType="date" width={130} />
      <Column dataField="CHIT_VMD" caption={t("CHIT_VMD", "Value Date")} dataType="date" width={130} />
      <Column dataField="DEBIT" caption={t("DEBIT", "Debit")} width={120} />
      <Column dataField="CREDIT" caption={t("CREDIT", "Credit")} width={120} />
      <Column dataField="AMOUNT" caption={t("AMOUNT", "Amount")} dataType="number" format="#,##0.00" width={130} />
      <Column dataField="CUSTOMER_CD" caption={t("CUSTOMER_CD", "Customer")} width={130} />
      <Column dataField="DEPARTMENT_CD" caption={t("DEPARTMENT_CD", "Department")} width={130} />
      <Column dataField="BANK_CD" caption={t("BANK_CD", "Bank")} width={120} />
      <Column dataField="PRODUCT_NM" caption={t("PRODUCT_NM", "Product")} minWidth={180} />
      <Column dataField="UNIT_NM" caption={t("UNIT_NM", "Unit")} width={100} />
      <Column dataField="QUANTITY" caption={t("QUANTITY", "Qty")} dataType="number" width={100} />
      <Column
        dataField="UNIT_PRICE"
        caption={t("UNIT_PRICE", "Unit Price")}
        dataType="number"
        format="#,##0.00"
        width={120}
      />
      <Column dataField="VAT_TYPE" caption={t("VAT_TYPE", "VAT Type")} width={120} />
      <Column
        dataField="VAT_AMOUNT"
        caption={t("VAT_AMOUNT", "VAT Amount")}
        dataType="number"
        format="#,##0.00"
        width={130}
      />
      <Column dataField="DETAIL_DESCRIPTION_VIET" caption={t("DESCRIPTION", "Description")} minWidth={220} />
      <Column dataField="PRODUCT_NOTE" caption={t("PRODUCT_NOTE", "Product Note")} minWidth={180} />
      <Column dataField="ISCOLLECT" caption={t("ISCOLLECT", "Collect")} dataType="boolean" width={100} />
      <Column dataField="ISPAY" caption={t("ISPAY", "Pay")} dataType="boolean" width={90} />
    </>
  )
}

export default ChitNoteDetailColumns
